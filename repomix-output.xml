const content: string = "\n/* ========================================================================== */\n/* ==================== 1. \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0648\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 ===================== */\n/* ========================================================================== */\n\nconst LEAF_SVG = `<svg class=\"leaf-icon\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n  <path d=\"M4 20 C 4 10, 12 4, 20 4 C 20 12, 14 20, 4 20 Z\" fill=\"#fff8ec\" opacity=\"0.85\"/>\n  <path d=\"M4 20 C 8 14, 12 10, 18 6\" stroke=\"#4c7a3f\" stroke-width=\"1.2\" fill=\"none\" opacity=\"0.7\"/>\n</svg>`;\n\n\n// \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0627\u0644\u0645\u062a\u0637\u0627\u0628\u0642\u0629 \u062a\u0645\u0627\u0645\u0627\u064b \u0645\u0639 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\nconst branchNames = {\n  dawoud: '\u062f\u0627\u0648\u0648\u062f',\n  abu_nawara: '\u0627\u0628\u0648 \u0646\u0648\u0627\u0631\u0647',\n  al_sous: '\u0639\u0628\u062f \u0627\u0644\u0642\u0627\u062f\u0631 (\u0627\u0644\u0635\u0648\u0635)',\n  abdullah: '\u0639\u0628\u062f\u0627\u0644\u0644\u0647',\n  al_jadaa: '\u0645\u0635\u0637\u0641\u0649 (\u0627\u0644\u062c\u062f\u0639)',\n  mohammed_sulaiman: '\u0645\u062d\u0645\u062f \u0633\u0644\u064a\u0645\u0627\u0646',\n  younes: '\u064a\u0648\u0646\u0633',\n  al_badawi: '\u0628\u062f\u0648\u064a',\n  mohammed_ali: '\u0645\u062d\u0645\u062f \u0639\u0644\u064a',\n  abu_baid: '\u0633\u0644\u064a\u0645\u0627\u0646 (\u0627\u0628\u0648 \u0628\u064a\u0636)',\n  al_khudair: '\u0627\u062d\u0645\u062f \u0627\u0644\u062e\u0636\u064a\u0631',\n  abdulhaq: '\u0639\u0628\u062f \u0627\u0644\u062d\u0642'\n};\n\n// \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0627\u0644\u0645\u062a\u0637\u0627\u0628\u0642\u06