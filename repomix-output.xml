    margin: 0 auto 1vh auto !important;
    border-bottom: 2px solid #c9974f !important;
    padding-bottom: 5px;
    width: 80%;
    flex-shrink: 0;
  }

  .lineage-stem {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    flex: 1;
    position: relative;
    margin: 0 auto;
  }

  .lineage-stem::before {
    content: '';
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
    margin: 0 auto;
    width: 3px;
    background: #6b8e5c !important;
    z-index: 1;
  }

  .lineage-leaf {
    background: #e6f2e6 !important;
    border: 2px solid #3a5c30 !important;
    padding: 0.5vh 20px;
    font-family: 'Cairo', sans-serif;
    font-size: min(17px, 2.3vh);
    font-weight: 800;
    color: #1f3d1f !important;
    min-width: 180px;
    text-align: center;
    position: relative;
    z-index: 2;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08) !important;
    margin: 0.4vh auto !important;
    flex-shrink: 1;
  }

  .lineage-leaf:nth-of-type(odd) { border-radius: 40px 0 40px 0 !important; }
  .lineage-leaf:nth-of-type(even) { border-radius: 0 40px 0 40px !important; }

  .lineage-leaf.lineage-focus {
    background: linear-gradient(160deg,#d3a765,#8a5f2e) !important;
    color: #fff !important;
    border-color: #8a5f2e !important;
    transform: scale(1.03);
  }

  .lineage-leaf.lineage-root {
    background: #c5e0c5 !important;
    border-color: #2d4a25 !important;
  }

  .lineage-ben-label {
    background: #fff !important;
    color: #6b8e5c !important;
    font-size: min(12px, 1.8vh);
    font-weight: 700;
    width: min(24px, 3.5vh);
    height: min(24px, 3.5vh);
    border-radius: 50%;
    border: 2px solid #6b8e5c !important;
    display: flex; align-items: center; justify-content: center;
    z-index: 2;
    margin: 0 auto !important;
    flex-shrink: 1;
  }

