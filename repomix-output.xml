// apps/admin/components/AddPersonModal.tsx
"use client";

import { useState, FormEvent } from "react";
import { VIRTUAL_ROOT_ID } from "@/lib/constants";
import { BRANCHES } from "@/lib/branches";

export interface CreatedPerson {
  id: number;
  name: string;
  birth_date: string | null;
  death_date: string | null;
}

interface AddPersonModalProps {
  isOpen: boolean;
  onClose: () => void;
  /** The person this new node will be a child of. Pass VIRTUAL_ROOT_ID (941) to add a brand-new top-level branch. */
  parentId: number;
  onCreated: (person: CreatedPerson) => void;
}

export default function AddPersonModal({ isOpen, onClose, parentId, onCreated }: AddPersonModalProps) {
  const [name, setName] = useState("");
  const [branchId, setBranchId] = useState("");
  const [birthDate, setBirthDate] = useState("");
  const [deathDate, setDeathDate] = useState("");
  const [isSubmitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const isNewBranchRoot = parentId === VIRTUAL_ROOT_ID;

  function resetAndClose() {
    setName("");
    setBranchId("");
    setBirthDate("");
    setDeathDate("");
    setError(null);
    onClose();
  }

  async function handleSubmit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setError(null);

    const trimmedName = name.trim();
    if (!trimmedName) {
      setError("يجب إدخال الاسم على الأقل!");
      return;
    }
    if (isNewBranchRoot && !branchId) {
      setError("يجب تحديد الفخذ عند إضافة فرع جديد بالكامل");
      return;
    }

    setSubmitting(true);
    try {
      const res = await fetch("/api/person", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-editor-password": sessionStorage.getItem("editorPassword") || "",
        },
        body: JSON.stringify({
          parent_id: parentId,
          name_text: trimmedName,
          birth_date: birthDate || null,
          death_date: deathDate || null,
          ...(isNewBranchRoot ? { branch_id: branchId } : {}),
        }),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => null);
        setError(body?.error || "فشلت الإضافة - تأكد من صلاحياتك");
        return;
      }

      const created = await res.json(); // { id, name }
      onCreated({
        id: created.id,
        name: created.name,
        birth_date: birthDate || null,
        death_date: deathDate || null,
      });
      resetAndClose();
    } catch {
      setError("تعذر الاتصال بقاعدة البيانات");
    } finally {
      setSubmitting(false);
    }
  }

  if (!isOpen) return null;

  return (
    <div
      onClick={resetAndClose}
      className="fixed inset-0 z-[1000] flex items-center justify-center bg-black/60 font-cairo"
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className="w-80 rounded-2xl bg-white p-6 text-center shadow-[0_10px_25px_rgba(0,0,0,0.3)]"
      >
        <h3 className="mb-5 mt-0 font-extrabold text-gold-deep">
          {isNewBranchRoot ? "إضافة فرع جديد" : "إضافة ابن جديد"}
        </h3>

        <form onSubmit={handleSubmit}>
          <input
            type="text"
            value={name}
            onChange={(e) => setName(e.target.value)}
            placeholder="الاسم (مطلوب)"
            className="mb-3 w-full rounded-lg border border-gold px-2.5 py-2.5 text-right outline-none"
            autoFocus
          />

          {isNewBranchRoot && (
            <select
              value={branchId}
              onChange={(e) => setBranchId(e.target.value)}
              className="mb-3 w-full rounded-lg border border-gray-300 px-2.5 py-2.5 text-right outline-none"
            >
              <option value="">اختر الفخذ...</option>
              {BRANCHES.map((b) => (
                <option key={b.id} value={b.id}>
                  {b.label}
                </option>
              ))}
            </select>
          )}

          <input
            type="date"
            value={birthDate}
            onChange={(e) => setBirthDate(e.target.value)}
            placeholder="سنة الولادة (مثال: 1990)"
            className="mb-3 w-full rounded-lg border border-gray-300 px-2.5 py-2.5 text-right outline-none"
          />
          <input
            type="date"
            value={deathDate}
            onChange={(e) => setDeathDate(e.target.value)}
            placeholder="سنة الوفاة (للمتوفين فقط)"
            className="mb-5 w-full rounded-lg border border-gray-300 px-2.5 py-2.5 text-right outline-none"
          />

          {error && <p className="mb-3 text-sm font-semibold text-maroon">{error}</p>}

          <div className="flex justify-center gap-2.5">
            <button
              type="submit"
              disabled={isSubmitting}
              className="flex-1 rounded-lg bg-green-2 px-4 py-2.5 font-bold text-white disabled:opacity-60"
            >
              {isSubmitting ? "جارٍ الحفظ..." : "حفظ البيانات"}
            </button>
            <button
              type="button"
              onClick={resetAndClose}
              disabled={isSubmitting}
              className="flex-1 rounded-lg bg-maroon px-4 py-2.5 font-bold text-white disabled:opacity-60"
            >
              إلغاء
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="apps/admin/components/AdminTreeView.tsx">
// apps/admin/components/AdminTreeView.tsx
"use client";

import { useCallback, useEffect, useState } from "react";
import type { FamilyNode } from "@/lib/constants";
import {
  addChildToTree,
  updateNodeInTree,
  removeNodeFromTree,
  findNodeById,
  getPathToRoot,
  countAllPeople,
} from "@/lib/treeUtils";
import TreeNode from "./TreeNode";
import AddPersonModal, { CreatedPerson } from "./AddPersonModal";
import EditPersonModal, { EditedPerson } from "./EditPersonModal";
import ConfirmDeleteModal, { DeleteTarget } from "./ConfirmDeleteModal";
import LineageCertificateModal from "./LineageCertificateModal";
import VisualTreeModal from "./VisualTreeModal";

export default function AdminTreeView() {
  const [tree, setTree] = useState<FamilyNode | null>(null);
  const [isLoading, setLoading] = useState(true);
  const [loadError, setLoadError] = useState<string | null>(null);

  // Which person the "add child" modal is currently adding under (null = closed).
  const [addModalParentId, setAddModalParentId] = useState<number | null>(null);

  // Which person is currently being edited (null = edit modal closed).
  const [editTarget, setEditTarget] = useState<EditedPerson | null>(null);

  // Which person is pending delete confirmation (null = delete modal closed).
  const [deleteTarget, setDeleteTarget] = useState<DeleteTarget | null>(null);

  // Ancestor chain for the lineage certificate modal (null = closed).
  const [lineagePath, setLineagePath] = useState<FamilyNode[] | null>(null);

  // Subtree currently shown in the D3 visual tree modal (null = closed).
  const [visualTreeRoot, setVisualTreeRoot] = useState<FamilyNode | null>(null);

  const loadTree = useCallback(async () => {
    setLoading(true);
    setLoadError(null);
    try {
      const res = await fetch("/api/tree");
      if (!res.ok) throw new Error("bad response");
      const data: FamilyNode = await res.json();
      setTree(data);
    } catch {
      setLoadError("تعذر تحميل شجرة العائلة");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadTree();
  }, [loadTree]);

  // ---- Add child ----

  function handleAddChild(parentId: number) {
    setAddModalParentId(parentId);
  }

  function handleCreated(created: CreatedPerson) {
    if (tree === null || addModalParentId === null) return;
    const newNode: FamilyNode = {
      id: created.id,
      name: created.name,
      birth_date: created.birth_date,
      death_date: created.death_date,
    };
    setTree(addChildToTree(tree, addModalParentId, newNode));
  }

  // ---- Edit / rename ----

  function handleEdit(id: number) {
    if (!tree) return;
    const node = findNodeById(tree, id);
    if (!node) return;
    setEditTarget({ id: node.id, name: node.name, birth_date: node.birth_date, death_date: node.death_date });
  }

  function handleSaved(edited: EditedPerson) {
    if (!tree) return;
    setTree(
      updateNodeInTree(tree, edited.id, {
        name: edited.name,
        birth_date: edited.birth_date,
        death_date: edited.death_date,
      })
    );
  }

  // ---- Delete ----

  function handleDelete(id: number) {
    if (!tree) return;
    const node = findNodeById(tree, id);
    if (!node) return;
    setDeleteTarget({ id: node.id, name: node.name });
  }

  function handleDeleted(id: number) {
    if (!tree) return;
    setTree(removeNodeFromTree(tree, id));
  }

  // ---- Lineage certificate (PDF via browser print) ----

  function handlePrintLineage(id: number) {
    if (!tree) return;
    // tree.children (not tree itself) since tree is the synthetic 941 root —
    // the certificate should start from a real branch root, not the sentinel.
    for (const branchRoot of tree.children ?? []) {
      const path = getPathToRoot(branchRoot, id);
      if (path) {
        setLineagePath(path);
        return;
      }
    }
  }

  // ---- Visual D3 tree modal (with its own SVG-to-PDF export) ----

  function handleViewTree(id: number) {
    if (!tree) return;
    const node = findNodeById(tree, id);
    if (node) setVisualTreeRoot(node);
  }

  if (isLoading) {
    return <p className="p-6 text-center text-ink-soft">جارٍ تحميل الشجرة...</p>;
  }

  if (loadError || !tree) {
    return (
      <div className="p-6 text-center">
        <p className="mb-3 text-maroon">{loadError ?? "لا توجد بيانات"}</p>
        <button
          type="button"
          onClick={loadTree}
          className="rounded-lg bg-gold-deep px-4 py-2 text-sm font-bold text-white"
        >
          إعادة المحاولة
        </button>
      </div>
    );
  }

  return (
    <div className="no-print min-h-screen bg-paper font-cairo">
      <div className="mx-auto max-w-3xl px-6 py-8">
        <h1 className="mb-1 text-center font-ruqaa text-3xl font-extrabold text-gold-deep">
          لوحة تعديل شجرة العائلة
        </h1>
        <p className="mb-6 text-center text-xs text-ink-soft">
          اضغط على أي بطاقة لعرض/إخفاء الأبناء، ومرر المؤشر فوقها لإظهار خيارات التعديل
        </p>

        <ul className="m-0 flex list-none flex-col gap-3 p-0">
          {/* tree itself is the synthetic 941/"System_Root" node — we render its
              children (the real branch roots) rather than the root marker. */}
          {(tree.children ?? []).map((branchRoot) => (
            <TreeNode
              key={branchRoot.id}
              node={branchRoot}
              onAddChild={handleAddChild}
              onEdit={handleEdit}
              onDelete={handleDelete}
              onPrintLineage={handlePrintLineage}
              onViewTree={handleViewTree}
              depth={0}
              defaultExpanded
            />
          ))}
        </ul>

        <AddPersonModal
          isOpen={addModalParentId !== null}
          parentId={addModalParentId ?? tree.id}
          onClose={() => setAddModalParentId(null)}
          onCreated={handleCreated}
        />

        <EditPersonModal
          isOpen={editTarget !== null}
          person={editTarget}
          onClose={() => setEditTarget(null)}
          onSaved={handleSaved}
        />

        <ConfirmDeleteModal
          isOpen={deleteTarget !== null}
          target={deleteTarget}
          onClose={() => setDeleteTarget(null)}
          onDeleted={handleDeleted}
        />

        <LineageCertificateModal
          isOpen={lineagePath !== null}
          ancestorPath={lineagePath}
          totalCount={countAllPeople(tree)}
          onClose={() => setLineagePath(null)}
        />

        <VisualTreeModal
          isOpen={visualTreeRoot !== null}
          rootNode={visualTreeRoot}
          onClose={() => setVisualTreeRoot(null)}
        />
      </div>
    </div>
  );
}
</file>

<file path="apps/admin/components/ConfirmDeleteModal.tsx">
// apps/admin/components/ConfirmDeleteModal.tsx
"use client";

import { useState } from "react";

export interface DeleteTarget {
  id: number;
  name: string;
}

interface ConfirmDeleteModalProps {
  isOpen: boolean;
  /** The person pending deletion, or null while the modal is closed. */
  target: DeleteTarget | null;
  onClose: () => void;
  onDeleted: (id: number) => void;
}

export default function ConfirmDeleteModal({ isOpen, target, onClose, onDeleted }: ConfirmDeleteModalProps) {
  const [isSubmitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);

  async function handleConfirm() {
    if (!target) return;
    setError(null);
    setSubmitting(true);
    try {
      const res = await fetch(`/api/person/${target.id}`, {
        method: "DELETE",
        headers: { "x-editor-password": sessionStorage.getItem("editorPassword") || "" },
      });

      if (!res.ok) {
        const body = await res.json().catch(() => null);
        // Matches the legacy fallback message when the API gives no specific reason
        // (e.g. the person still has children — blocked by the DB's foreign key).
        setError(
          body?.error || "فشل الحذف. تأكد أن هذا الشخص ليس لديه أبناء (يجب حذف أبنائه أولاً)."
        );
        return;
      }

      onDeleted(target.id);
      onClose();
    } catch {
      setError("تعذر الاتصال بقاعدة البيانات");
    } finally {
      setSubmitting(false);
    }
  }

  if (!isOpen || !target) return null;

  return (
    <div
      onClick={onClose}
      className="fixed inset-0 z-[1000] flex items-center justify-center bg-black/60 font-cairo"
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className="w-80 rounded-2xl bg-white p-6 text-center shadow-[0_10px_25px_rgba(0,0,0,0.3)]"
      >
        <h3 className="mb-3 mt-0 font-extrabold text-maroon">تأكيد الحذف</h3>
        <p className="mb-5 text-sm text-ink">
          هل أنت متأكد من حذف <span className="font-bold">"{target.name}"</span> نهائياً من قاعدة
          البيانات؟
        </p>

        {error && <p className="mb-3 text-sm font-semibold text-maroon">{error}</p>}

        <div className="flex justify-center gap-2.5">
          <button
            type="button"
            onClick={handleConfirm}
            disabled={isSubmitting}
            className="flex-1 rounded-lg bg-maroon px-4 py-2.5 font-bold text-white disabled:opacity-60"
          >
            {isSubmitting ? "جارٍ الحذف..." : "حذف نهائياً"}
          </button>
          <button
            type="button"
            onClick={onClose}
            disabled={isSubmitting}
            className="flex-1 rounded-lg bg-gray-400 px-4 py-2.5 font-bold text-white disabled:opacity-60"
          >
            إلغاء
          </button>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="apps/admin/components/EditPersonModal.tsx">
// apps/admin/components/EditPersonModal.tsx
"use client";

import { useEffect, useState, FormEvent } from "react";

export interface EditedPerson {
  id: number;
  name: string;
  birth_date: string | null;
  death_date: string | null;
}

interface EditPersonModalProps {
  isOpen: boolean;
  /** The person being edited, or null while the modal is closed. */
  person: EditedPerson | null;
  onClose: () => void;
  onSaved: (person: EditedPerson) => void;
}

export default function EditPersonModal({ isOpen, person, onClose, onSaved }: EditPersonModalProps) {
  const [name, setName] = useState("");
  const [birthDate, setBirthDate] = useState("");
  const [deathDate, setDeathDate] = useState("");
  const [isSubmitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Re-fill the form whenever a new person is opened for editing.
  useEffect(() => {
    if (person) {
      setName(person.name);
      setBirthDate(person.birth_date ?? "");
      setDeathDate(person.death_date ?? "");
      setError(null);
    }
  }, [person]);

  async function handleSubmit(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (!person) return;
    setError(null);

    const trimmedName = name.trim();
    if (!trimmedName) {
      setError("يجب إدخال الاسم على الأقل!");
      return;
    }

    setSubmitting(true);
    try {
      const res = await fetch(`/api/person/${person.id}`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
          "x-editor-password": sessionStorage.getItem("editorPassword") || "",
        },
        body: JSON.stringify({
          name_text: trimmedName,
          birth_date: birthDate || null,
          death_date: deathDate || null,
        }),
      });

      if (!res.ok) {
        const body = await res.json().catch(() => null);
        setError(body?.error || "فشل التعديل");
        return;
      }

      onSaved({
        id: person.id,
        name: trimmedName,
        birth_date: birthDate || null,
        death_date: deathDate || null,
      });
      onClose();
    } catch {
      setError("تعذر الاتصال بقاعدة البيانات");
    } finally {
      setSubmitting(false);
    }
  }

  if (!isOpen || !person) return null;

  return (
    <div
      onClick={onClose}
      className="fixed inset-0 z-[1000] flex items-center justify-center bg-black/60 font-cairo"
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className="w-80 rounded-2xl bg-white p-6 text-center shadow-[0_10px_25px_rgba(0,0,0,0.3)]"
      >
        <h3 className="mb-5 mt-0 font-extrabold text-gold-deep">تعديل بيانات: {person.name}</h3>

        <form onSubmit={handleSubmit}>
          <input
            type="text"
            value={name}
            onChange={(e) => setName(e.target.value)}
            placeholder="الاسم (مطلوب)"
            className="mb-3 w-full rounded-lg border border-gold px-2.5 py-2.5 text-right outline-none"
            autoFocus
          />
          <input
            type="date"
            value={birthDate}
            onChange={(e) => setBirthDate(e.target.value)}
            className="mb-3 w-full rounded-lg border border-gray-300 px-2.5 py-2.5 text-right outline-none"
          />
          <input
            type="date"
            value={deathDate}
            onChange={(e) => setDeathDate(e.target.value)}
            className="mb-5 w-full rounded-lg border border-gray-300 px-2.5 py-2.5 text-right outline-none"
          />

          {error && <p className="mb-3 text-sm font-semibold text-maroon">{error}</p>}

          <div className="flex justify-center gap-2.5">
            <button
              type="submit"
              disabled={isSubmitting}
              className="flex-1 rounded-lg bg-green-2 px-4 py-2.5 font-bold text-white disabled:opacity-60"
            >
              {isSubmitting ? "جارٍ الحفظ..." : "حفظ التعديلات"}
            </button>
            <button
              type="button"
              onClick={onClose}
              disabled={isSubmitting}
              className="flex-1 rounded-lg bg-maroon px-4 py-2.5 font-bold text-white disabled:opacity-60"
            >
              إلغاء
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

