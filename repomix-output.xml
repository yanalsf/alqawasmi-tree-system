ctiveTree]);\n}\n\nfunction navigateToNodeId(id){\n  const ancestors = getAncestors(activeTree, id, []);\n  if(ancestors) navigateToPath(ancestors);\n}\n\n/* ---------------------------------------------------------------------- */\n\nfunction renderBreadcrumb(){\n  const bc = document.getElementById('breadcrumb');\n  bc.innerHTML = '';\n  currentPath.forEach((node, i) => {\n    if(i > 0){\n      const sep = document.createElement('span');\n      sep.className = 'sep';\n      sep.textContent = '\u2039';\n      bc.appendChild(sep);\n    }\n    const btn = document.createElement('button');\n    const isCurrent = i === currentPath.length - 1;\n    btn.className = isCurrent ? 'current' : '';\n    btn.textContent = node.name;\n    if(!isCurrent){\n      btn.addEventListener('click', () => navigateToPath(currentPath.slice(0, i + 1)));\n    }\n    bc.appendChild(btn);\n  });\n  bc.scrollLeft = bc.scrollWidth;\n}\n\n\n// \u062f\u0627\u0644\u0629 \u0644\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0644\u0627\u0633\u0645 \u0634\u0647\u0631 (\u0645\u062b\u0627\u0644: 15 \u0645\u0627\u064a\u0648 1990)\nfunction displayNiceDate(dateStr) {\n  if (!dateStr) return '';\n  const d = new Date(dateStr);\n  return d.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });\n}\n\n\n// \u062f\u0627\u0644\u0629 \u0644\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0633\u0646\u0629 \u0641\u0642\u0637 \u0645\u0646 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0644\u0644\u0639\u0631\u0636\nfunction getYearOnly(dateStr) {\n  if (!dateStr) return '';\n  return new Date(dateStr).getFullYear();\n}\n\n// \u062f\u0627\u0644\u0629 \u062d\u0633\u0627\u0628 \u0627\u0644\u0639\u0645\u0631 \u0628\u062f\u0642\u0629 (\u062a\u0623\u062e\u0630 \u0628\u0639\u064a\u0646 \u0627\u0644\u0627\u0639\u062a\u0628\u0627\u0631 \u0627\u0644\u0634\u0647\u0631 \u0648\u0627\u0644\u064a\u0648\u0645) - \u062a\u0623\u0643\u062f \u0623\u0646\u0647\u0627 \u0645\u0648\u062c\u0648\u062f\u0629 \u0639\u0646\u062f\u0643\nfunction calculateExactAge(birthDateStr, deathDateStr) {\n  if (!birthDateStr) return '';\n  const birth = new Date(birthDateStr);\n  const end = deathDateStr ? new Date(deathDateStr) : new Date();\n  let age = end.getFullYear() - birth.getFullYear();\n  const m = end.getMonth() - birth.getMonth();\n  if (m < 0 || (m === 0 && end.getDate() < birth.getDate())) {\n    age--; \n  }\n  return age;\n}\n\n\n// \u062f\u0627\u0644\u0629 \u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0639\u0645\u0631 \u0628\u062f\u0642\u0629 (\u062a\u0623\u062e\u0630 \u0628\u0639\u064a\u0646 \u0627\u0644\u0627\u0639\u062a\u0628\u0627\u0631 \u0627\u0644\u0634\u0647\u0631 \u0648\u0627\u0644\u064a\u0648\u0645)\nfunction calculateExactAge(birthDateStr, deathDateStr) {\n  if (!birthDateStr) return '';\n  const birth = new Date(birthDateStr);\n  const end = deathDateStr ? new Date(deathDateStr) : new Date();\n  let age = end.getFullYear() - birth.getFullYear();\n  const m = end.getMonth() - birth.getMonth();\n  if (m < 0 || (m === 0 && end.getDate() < birth.getDate())) {\n    age--; // \u0625\u0646\u0642\u0627\u0635 \u0633\u0646\u0629 \u0625\u0630\u0627 \u0644\u0645 \u064a\u0623\u062a\u0650 \u064a\u0648\u0645 \u0645\u064a\u0644\u0627\u062f\u0647 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0646\u0629 \u0628\u0639\u062f\n  }\n  return age;\n}\n\n\nfunction renderPage(){\n  const focus = currentFocus();\n  const isRoot = currentPath.length === 1;\n  const kidsCount = focus.children ? focus.children.length : 0;\n\n  document.getElementById('backBtn').disabled = isRoot;\n  renderBreadcrumb();\n\n  const page = document.getElementById('pageContent');\n  page.innerHTML = '';\n  void page.offsetWidth;\n\n  // 1. \u0628\u0646\u0627\u0621 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0628 (\u0627\u0644\u0643\u0628\u064a\u0631\u0629)\n  const focusCard = document.createElement('div');\n  focusCard.className = 'focus-card reveal ' + (kidsCount ? 'has-children' : 'no-children');\n  focusCard.innerHTML = LEAF_SVG;\n\n  // \u0627\u0633\u062a\u0631\u062c\u0627\u0639 \u0627\u0633\u0645 \u0627\u0644\u0623\u0628\nconst nameEl = document.createElement('div');\n  nameEl.className = 'name';\n  nameEl.textContent = focus.name.replace('\u0641\u062e\u0630 ', '').trim();\n  focusCard.appendChild(nameEl);\n\n// \u0639\u0631\u0636 \u0627\u0644\u0633\u0646\u0629 \u0641\u0642\u0637 \u0648\u0639\u0645\u0631 \u0627\u0644\u0623\u0628 (\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0643\u0628\u064a\u0631\u0629)\n  if (focus.birth_date || focus.death_date) {\n    const focusDatesDiv = document.createElement('div');\n    focusDatesDiv.style.cssText = 'font-size: 13.5px; color: #fff9ee; margin-top: 4px; line-height: 1.4; opacity: 0.95;';\n    let fDateStr = '', fAgeStr = '';\n    \n    if (focus.birth_date && focus.death_date) {\n      fDateStr = `${getYearOnly(focus.birth_date)} - ${getYearOnly(focus.death_date)}`;\n      fAgeStr = `\u062a\u0648\u0641\u064a \u0639\u0646 ${calculateExactAge(focus.birth_date, focus.death_date)} \u0639\u0627\u0645\u0627\u064b`;\n    } else if (focus.birth_date) {\n      fDateStr = ` \u0648\u0644\u062f \u0641\u064a -  ${getYearOnly(focus.birth_date)}`;\n      fAgeStr = `\u0627\u0644\u0639\u0645\u0631: ${calculateExactAge(focus.birth_date, null)}`;\n    } else if (focus.death_date) {\n      fDateStr = `\u062a\u0648\u0641\u064a \u0639\u0627\u0645 ${getYearOnly(focus.death_date)}`;\n    }\n    \n    focusDatesDiv.innerHTML = `<span>${fDateStr}</span> <br> <span style=\"font-size: 12px;\">${fAgeStr}</span>`;\n    focusCard.appendChild(focusDatesDiv);\n  }\n\n  if(!isRoot){\n    const fatherName = currentPath[currentPath.length - 2].name;\n    const fatherTag = document.createElement('div');\n    fatherTag.className = 'father-tag';\n    fatherTag.textContent = `\u0627\u0628\u0646 ${fatherName}`;\n    focusCard.appendChild(fatherTag);\n  }\n\n  const meta = document.createElement('div');\n  meta.className = 'meta';\n  const descCount = countDescendants(focus);\n  meta.textContent = kidsCount\n    ? `${kidsCount} \u0645\u0646 \u0627\u0644\u0623\u0628\u0646\u0627\u0621 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u064a\u0646 \u2014 ${descCount} \u0641\u0631\u062f\u064b\u0627 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0641\u0631\u0639`\n    : '\u0644\u0627 \u064a\u0648\u062c\u062f \u0623\u0628\u0646\u0627\u0621 \u0645\u0633\u062c\u0644\u0648\u0646';\n  focusCard.appendChild(meta);\n\n  // \u0623\u0632\u0631\u0627\u0631 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0628\n  const focusActions = document.createElement('div');\n  focusActions.className = 'focus-actions';\n\n  const drawTreeBtn = document.createElement('button');\n  drawTreeBtn.className = 'btn ghost small';\n  drawTreeBtn.innerHTML = '\ud83c\udf3f \u0639\u0631\u0636 \u0627\u0644\u0634\u062c\u0631\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629';\n  drawTreeBtn.addEventListener('click', () => {\n    openVisualTree(focus);\n  });\n  focusActions.appendChild(drawTreeBtn);\n\n  const addBtn = document.createElement('button');\n  addBtn.className = 'btn small';\n  addBtn.textContent = '+ \u0625\u0636\u0627\u0641\u0629 \u0627\u0628\u0646';\n  addBtn.addEventListener('click', () => {\n    openModal('\u0625\u0636\u0627\u0641\u0629 \u0627\u0628\u0646 \u062c\u062f\u064a\u062f', '', '', '', async (newName, newBirth, newDeath) => {\n      try {\n        const res = await fetch('/api/person', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json',\n            'x-editor-password': sessionStorage.getItem('editorPassword') || ''\n          },\n          body: JSON.stringify({ parent_id: focus.id, name_text: newName, birth_date: newBirth, death_date: newDeath })\n        });\n        if (!res.ok) return alert('\u0641\u0634\u0644\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629 - \u062a\u0623\u0643\u062f \u0645\u0646 \u0635\u0644\u0627\u062d\u064a\u0627\u062a\u0643');\n        const created = await res.json();\n        if (!focus.children) focus.children = [];\n        \n        const child = { id: created.id, name: created.name, birth_date: newBirth, death_date: newDeath, children: [] };\n        assignIds(child, focus._depth + 1);\n        focus.children.push(child);\n        rebuildSidebar();\n        renderPage();\n      } catch (error) {\n        alert('\u062a\u0639\u0630\u0631 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a');\n      }\n    });\n  });\n  focusActions.appendChild(addBtn);\n\n  if(!isRoot){\n    const renameBtn = document.createElement('button');\n    renameBtn.className = 'btn small';\n    renameBtn.textContent = '\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0627\u0633\u0645';\n    renameBtn.addEventListener('click', () => {\n      // \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0644\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0623\u0628\n      openModal('\u062a\u0639\u062f\u064a\u0644 \u0628\u064a\u0627\u0646\u0627\u062a: ' + focus.name, focus.name, focus.birth_date, focus.death_date, async (newName, newBirth, newDeath) => {\n        try {\n          const res = await fetch(`/api/person/${focus.id}`, {\n            method: 'PUT',\n            headers: {\n              'Content-Type': 'application/json',\n              'x-editor-password': sessionStorage.getItem('editorPassword') || ''\n            },\n            body: JSON.stringify({ name_text: newName, birth_date: newBirth, death_date: newDeath })\n          });\n          if (!res.ok) return alert('\u0641\u0634\u0644 \u0627\u0644\u062a\u0639\u062f\u064a\u0644');\n          focus.name = newName;\n          focus.birth_date = newBirth;\n          focus.death_date = newDeath;\n          rebuildSidebar();\n          renderPage();\n        } catch (error) {\n          alert('\u062a\u0639\u06