ild.death_date) {\n          dateStr = `${getYearOnly(child.birth_date)} - ${getYearOnly(child.death_date)}`;\n          ageStr = `\u062a\u0648\u0641\u064a \u0639\u0646 ${calculateExactAge(child.birth_date, child.death_date)} \u0639\u0627\u0645\u0627\u064b`;\n        } else if (child.birth_date) {\n          dateStr = ` \u0648\u0644\u062f \u0641\u064a - ${getYearOnly(child.birth_date)}`;\n          ageStr = `\u0627\u0644\u0639\u0645\u0631: ${calculateExactAge(child.birth_date, null)}`;\n        } else if (child.death_date) {\n          dateStr = `\u062a\u0648\u0641\u064a \u0639\u0627\u0645 ${getYearOnly(child.death_date)}`;\n        }\n        \n        datesDiv.innerHTML = `<span style=\"font-weight:bold;\">${dateStr}</span> <br> <span style=\"font-size: 10.5px;\">${ageStr}</span>`;\n        card.appendChild(datesDiv);\n      }\n\n      const fatherTag = document.createElement('div');\n      fatherTag.className = 'father-tag';\n      fatherTag.textContent = `\u0627\u0628\u0646 ${focus.name}`;\n      card.appendChild(fatherTag);\n\n      const sub = document.createElement('div');\n      sub.className = 'sub';\n      sub.textContent = childKids ? `${childKids} \u0623\u0628\u0646\u0627\u0621` : '\u0628\u062f\u0648\u0646 \u0623\u0628\u0646\u0627\u0621';\n      card.appendChild(sub);\n\n      if(childKids){\n        const badge = document.createElement('span');\n        badge.className = 'count-badge';\n        const total = countDescendants(child);\n        badge.textContent = total > 99 ? '99+' : total;\n        card.appendChild(badge);\n      }\n\n      // \u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0642\u0644\u0645 (\u062a\u0639\u062f\u064a\u0644)\n      const pencil = document.createElement('button');\n      pencil.className = 'edit-pencil';\n      pencil.textContent = '\u270e';\n      pencil.title = '\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a';\n      pencil.addEventListener('click', (e) => {\n        e.stopPropagation();\n        openModal('\u062a\u0639\u062f\u064a\u0644 \u0628\u064a\u0627\u0646\u0627\u062a: ' + child.name, child.name, child.birth_date, child.death_date, async (newName, newBirth, newDeath) => {\n          try {\n            const res = await fetch(`/api/person/${child.id}`, {\n              method: 'PUT',\n              headers: {\n                'Content-Type': 'application/json',\n                'x-editor-password': sessionStorage.getItem('editorPassword') || ''\n              },\n              body: JSON.stringify({ name_text: newName, birth_date: newBirth, death_date: newDeath })\n            });\n            if (!res.ok) return alert('\u0641\u0634\u0644 \u0627\u0644\u062a\u0639\u062f\u064a\u0644');\n            \n            child.name = newName;\n            child.birth_date = newBirth;\n            child.death_date = newDeath;\n            rebuildSidebar();\n            renderPage();\n          } catch (error) {\n            alert('\u062a\u0639\u0630\u0631 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a');\n          }\n        });\n      });\n      card.appendChild(pencil);\n\n      // \u0623\u064a\u0642\u0648\u0646\u0629 \u0633\u0644\u0629 \u0627\u0644\u0645\u0647\u0645\u0644\u0627\u062a (\u062d\u0630\u0641)\n      const trashBtn = document.createElement('button');\n      trashBtn.className = 'delete-trash';\n      trashBtn.textContent = '\ud83d\uddd1\ufe0f';\n      trashBtn.title = '\u062d\u0630\u0641 \u0627\u0644\u0627\u0628\u0646';\n      trashBtn.addEventListener('click', async (e) => {\n        e.stopPropagation(); \n        const confirmDel = confirm(`\u0647\u0644 \u0623\u0646\u062a \u0645\u062a\u0623\u0643\u062f \u0645\u0646 \u062d\u0630\u0641 \"${child.name}\" \u0646\u0647\u0627\u0626\u064a\u0627\u064b \u0645\u0646 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u061f`);\n        if (!confirmDel) return;\n\n        try {\n          const res = await fetch(`/api/person/${child.id}`, {\n            method: 'DELETE',\n            headers: { 'x-editor-password': sessionStorage.getItem('editorPassword') || '' }\n          });\n\n          if (!res.ok) {\n            const errData = await res.json();\n            return alert(errData.error || '\u0641\u0634\u0644 \u0627\u0644\u062d\u0630\u0641. \u062a\u0623\u0643\u062f \u0623\u0646 \u0647\u0630\u0627 \u0627\u0644\u0634\u062e\u0635 \u0644\u064a\u0633 \u0644\u062f\u064a\u0647 \u0623\u0628\u0646\u0627\u0621 (\u064a\u062c\u0628 \u062d\u0630\u0641 \u0623\u0628\u0646\u0627\u0626\u0647 \u0623\u0648\u0644\u0627\u064b).');\n          }\n\n          focus.children = focus.children.filter(c => c.id !== child.id);\n          if (focus.children.length === 0) delete focus.children;\n          \n          rebuildSidebar();\n          renderPage();\n        } catch (error) {\n          alert('\u062a\u0639\u0630\u0631 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a');\n        }\n      });\n      card.appendChild(trashBtn);\n      \n      // \u0627\u0644\u062f\u062e\u0648\u0644 \u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0627\u0628\u0646 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629\n      card.addEventListener('click', () => navigateIntoChild(child));\n      grid.appendChild(card);\n    });\n    page.appendChild(grid);\n  } else {\n    const empty = document.createElement('div');\n    empty.className = 'empty-state';\n    empty.textContent = '\u0644\u0627 \u064a\u0648\u062c\u062f \u0623\u0628\u0646\u0627\u0621 \u0645\u0633\u062c\u0644\u064a\u0646 \u0644\u0647\u0630\u0627 \u0627\u0644\u0627\u0633\u0645 \u062d\u062a\u0649 \u0627\u0644\u0622\u0646.';\n    page.appendChild(empty);\n  }\n\n  updateStats();\n  requestAnimationFrame(() => observeReveal(page));\n}\n\nfunction updateStats(){\n  document.getElementById('statsBar').textContent =\n    `\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0641\u064a \u0627\u0644\u0634\u062c\u0631\u0629: ${countAll(activeTree)} \u2014 \u0639\u062f\u062f \u0627\u0644\u0623\u062c\u064a\u0627\u0644: ${maxDepth(activeTree)}`;\n}\n\ndocument.getElementById('backBtn').addEventListener('click', goBack);\ndocument.getElementById('homeBtn').addEventListener('click', goHome);\ndocument.getElementById('exportBtn').addEventListener('click', () => {\n  const clean = (node) => {\n    const out = { name: node.name };\n    if(node.children && node.children.length) out.children = node.children.map(clean);\n    return out;\n  };\n  const data = JSON.stringify(clean(activeTree), null, 2);\n  const blob = new Blob([data], { type: 'application/json' });\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement('a');\n  a.href = url; a.download = 'family-tree.json'; a.click();\n  URL.revokeObjectURL(url);\n});\n/* ---------------- Sidebar index + search ---------------- */\nconst sidebarList = document.getElementById('sidebarList');\nlet flatIndex = [];\n\nfunction buildFlatIndex(){\n  flatIndex = [];\n  (function walk(node, fatherName){\n    flatIndex.push({ id: node._id, name: node.name, depth: node._depth, father: fatherName });\n    if(node.children) node.children.forEach(c => walk(c, node.name));\n  })(activeTree, null);\n}\n\nfunction rebuildSidebar(){\n  buildFlatIndex();\n  sidebarList.innerHTML = '';\n  flatIndex.forEach(item => {\n    const li = document.createElement('li');\n    const btn = document.createElement('button');\n    btn.dataset.name = item.name;\n    const row = document.createElement('div');\n    row.style.display = 'flex';\n    row.style.alignItems = 'center';\n    row.style.gap = '6px';\n    const dot = document.createElement('span');\n    dot.className = 'depth-dot';\n    dot.style.opacity = Math.max(0.25, 1 - item.depth * 0.18);\n    row.appendChild(dot);\n    const label = document.createElement('span');\n    label.textContent = item.name;\n    row.appendChild(label);\n    btn.appendChild(row);\n    if(item.father){\n      const fatherTag = document.createElement('span');\n      fatherTag.className = 'father-tag';\n      fatherTag.textContent = `\u0627\u0628\u0646 ${item.father}`;\n      btn.appendChild(fatherTag);\n    }\n    btn.style.paddingRight = (10 + item.depth * 10) + 'px';\n    btn.addEventListener('click', () => {\n      navigateToNodeId(item.id);\n      if(window.innerWidth <= 900) closeSidebar();\n    });\n    li.appendChild(btn);\n    sidebarList.appendChild(li);\n  });\n  document.getElementById('sidebarCount').textContent = `${flatIndex.length} \u0627\u0633\u0645\u064b\u0627`;\n}\n\ndocument.getElementById('sidebarSearch').addEventListener('input', (e) => {\n  const q = e.target.value.trim();\n  const items = sidebarList.querySelectorAll('li');\n  let visible = 0;\n  items.forEach(li => {\n    const btn = li.querySelector('button');\n    const match = !q || btn.dataset.name.includes(q);\n    li.classList.toggle('hidden', !match);\n    if(match) visible++;\n  });\n  document.getElementById('sidebarCount').textContent = q ? `${visible} \u0646\u062a\u064a\u062c\u0629` : `${flatIndex.length} \u0627\u0633\u0645\u064b\u0627`;\n});\n\n/* ---------------- Mobile sidebar toggle ---------------- */\nconst sidebar = document.getElementById('sidebar');\nconst overlay = document.getElementById('sidebarOverlay');\nconst sidebarToggleBtn = document.getElementById('sidebarToggle'); // \u062c\u0644\u0628 \u0632\u0631 \u0627\u0644\u0641\u0647\u0631\u0633\n\nfunction openSidebar(){ \n  sidebar.classList.add('open'); \n  overlay.classList.add('open'); \n  sidebarToggleBtn.style.display = 'none'; // \u0625\u062e\u0641\u0627\u0621 \u0627\u0644\u0632\u0631 \u0639\u0646\u062f \u0641\u062a\u062d \u0627\u0644\u0641\u0647\u0631\u0633\n}\nfunction closeSidebar(){ \n  sidebar.classList.remove('open'); \n  overlay.classList.remove('open'); \n  sidebarToggleBtn.style.display = 'block'; // \u0625\u0639\u0627\u062f\u0629 \u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0632\u0631 \u0639\u0646\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0641\u0647\u0631\u0633\n}\n\ndocument.getElementById('sidebarToggle').addEventListener('click', openSidebar);\ndocument.getElementById('sidebarClose').addEventListener('click', closeSidebar);\noverlay.addEventListener('click', closeSidebar);\n\n/* ---------------- Screen switching ---------------- */\nconst screens = {\n  branchSelect: document.getElementById('branchSelect'),\n  branchPlaceholder: document.getElementById('branchPlaceholder'),\n  app: document.getElementById('app')\n};\n\nfunction showScreen(key){\n  screens.branchSelect.classList.remove('visible');\n  screens.branchPlaceholder.classList.remove('visible');\n  screens.app.classList.remove('app-visible');\n  screens.app.style.display = 'none';\n  if(key === 'app'){\n    screens.app.style.display = 'block';\n    requestAnimationFrame(() => screens.app.classList.add('app-visible'));\n  } else {\n    screens[key].classList.add('visible');\n  }\n  window.scrollTo({ top: 0, behavior: 'smooth' });\n}\n\n// 1. \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0627\u0644\u0645\u062a\u0637\u0627\u0628\u0642\u0629 \u062a\u0645\u0627\u0645\u0627\u064b \u0645\u0639 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\nconst branchNames = {\n  dawoud: '\u062f\u0627\u0648\u0648\u062f',\n  abu_nawara: '\u0627\u0628\u0648 \u0646\u0648\u0627\u0631\u0647',\n  al_sous: '\u0639\u0628\u062f \u0627\u0644\u0642\u0627\u062f\u0631 (\u0627\u0644\u0635\u0648\u0635)',\n  abdullah: '\u0639\u0628\u062f\u0627\u0644\u0644\u0647',\n  al_jadaa: '\u0645\u0635\u0637\u0641\u0649 (\u0627\u0644\u062c\u062f\u0639)',\n  mohammed_sulaiman: '\u0645\u062d\u0645\u062f \u0633\u0644\u064a\u0645\u0627\u0646',\n  younes: '\u064a\u0648\u0646\u0633',\n  al_badawi: '\u0628\u062f\u0648\u064a',\n  mohammed_ali: '\u0645\u062d\u0645\u062f \u0639\u0644\u064a',\n  abu_baid: '\u0633\u0644\u064a\u0645\u0627\u0646 (\u0627\u0628\u0648 \u0628\u064a\u0636)',\n  al_khudair: '\u0627\u062d\u0645\u062f \u0627\u0644\u062e\u0636\u064a\u0631',\n  abdulhaq: '\u0639\u0628\u062f \u0627\u0644\u062d\u0642'\n};\n\n/* --- 2. \u062f\u0627\u0644\u0629 \u0627\u0644\u062f\u062e\u0648\u0644 \u0644\u0644\u0623\u0641\u062e\u0627\u0630 (\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0643\u0628\u0633\u0627\u062a) --- */\nfunction selectBranch(key) {\n  const selectedBranchName = branchNames[key] || '\u0634\u062c\u0631\u0629 \u0627\u0644\u0639\u0627\u0626\u0644\u0629';\n\n  // \u0636\u0645\u0627\u0646 \u0625\u0646\u0634\u0627\u0621 \u0634\u062c\u0631\u0629 \u0641\u0627\u0631\u063a\u0629 \u0644\u0644\u0645\u062f\u064a\u0631 \u0625\u0630\u0627 \u0644\u0645 \u064a\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0644\u064a\u062a\u0645\u0643\u0646 \u0645\u0646 \u0627\u0644\u0625\u0636\u0627\u0641\u0629\n  if (!allBranches[key]) {\n    allBranches[key] = { id: null, name: selectedBranchName, children: [] };\n  }\n\n  // \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646\n  document.getElementById('headerLeftBtn').textContent = selectedBranchName;\n  document.getElementById('vtTitle').textContent = `\u0634\u062c\u0631\u0629 \u0646\u0633\u0628: ${selectedBranchName}`;\n\n  // \u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0646\u0638\u0627\u0645 \u0644\u0644\u0641\u062e\u0630 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\n  currentBranchKey = key;\n  activeTree = allBranches[key];\n  currentPath = [activeTree];\n\n  assignIds(activeTree, 0);\n  buildFlatIndex();\n  rebuildSidebar();\n  renderPage();\n\n  // \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0644\u0644\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u062e\u0636\u0631\u0627\u0621 \u0645\u0628\u0627\u0634\u0631\u0629\n  setTimeout(() => showScreen('app'), 250);\n\n  if (typeof closeHeaderDropdown === 'function') closeHeaderDropdown();\n}\n\n/* --- 3. \u0631\u0628\u0637 \u0627\u0644\u0643\u0628\u0633\u0627\u062a \u0628\u0627\u0644\u062f\u0627\u0644\u0629 --- */\ndocument.querySelectorAll('.branch-card').forEach(card => {\n  card.onclick = () => {\n    const branchId = card.getAttribute('data-branch');\n    if (branchId) selectBranch(branchId);\n  };\n});\n\n// \u062a\u0641\u0639\u064a\u0644 \u0632\u0631 \u0627\u0644\u0631\u062c\u0648\u0639 \u0645\u0646 \u0635\u0641\u062d\u0629 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631\nconst placeholderBackBtn = document.getElementById('branchPlaceholderBack');\nif (placeholderBackBtn) {\n  placeholderBackBtn.onclick = () => showScreen('branchSelect');\n}\n\n/* --- 4. \u0632\u0631 \u0627\u0644\u062f\u062e\u0648\u0644 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0648\u062c\u0644\u0628 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0646 \u0627\u0644\u0633\u064a\u0631\u0641\u0631 --- */\ndocument.getElementById('enterBtn').onclick = async () => {\n  const password = prompt('\u0627\u0644\u0631\u062c\u0627\u0621 \u0625\u062f\u062e\u0627\u0644 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0644\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a:');\n  if (!password) return;\n\n  sessionStorage.setItem('editorPassword', password.trim());\n\n  try {\n    const res = await fetch('/api/tree');\n    if (!res.ok) throw new Error('\u0641\u0634\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644');\n\n    const treeData = await res.json();\n\n    // \u062a\u0641\u0631\u064a\u063a \u0627\u0644\u0645\u062a\u063a\u064a\u0631 \u0627\u0644\u0639\u0627\u0645 \u0648\u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u0628\u0626\u062a\u0647\n    allBranches = {};\n\n    Object.keys(branchNames).forEach(key => {\n      allBranches[key] = { id: null, name: branchNames[key], children: [] };\n    });\n\n    if (treeData) {\n      if (treeData.name === 'System_Root' && treeData.children) {\n        treeData.children.forEach(branch => {\n          if (branch.name.includes('\u062f\u0627\u0648\u0648\u062f')) allBranches['dawoud'] = branch;\n          else if (branch.name.includes('\u0646\u0648\u0627\u0631\u0647')) allBranches['abu_nawara'] = branch;\n          else if (branch.name.includes('\u0627\u0644\u0635\u0648\u0635')) allBranches['al_sous'] = branch;\n          else if (branch.name.includes('\u0639\u0628\u062f\u0627\u0644\u0644\u0647')) allBranches['abdullah'] = branch;\n          else if (branch.name.includes('\u0627\u0644\u062c\u062f\u0639')) allBranches['al_jadaa'] = branch;\n          else if (branch.name.includes('\u0645\u062d\u0645\u062f \u0633\u0644\u064a\u0645\u0627\u0646')) allBranches['mohammed_sulaiman'] = branch;\n          else if (branch.name.includes('\u064a\u0648\u0646\u0633')) allBranches['younes'] = branch;\n          else if (branch.name.includes('\u0628\u062f\u0648\u064a')) allBranches['al_badawi'] = branch;\n          else if (branch.name.includes('\u0645\u062d\u0645\u062f \u0639\u0644\u064a')) allBranches['mohammed_ali'] = branch;\n          else if (branch.name.includes('\u0628\u064a\u0636')) allBranches['abu_baid'] = branch;\n          else if (branch.name.includes('\u0627\u0644\u062e\u0636\u064a\u0631')) allBranches['al_khudair'] = branch;\n          else if (branch.name.includes('\u0627\u0644\u062d\u0642')) allBranches['abdulhaq'] = branch;\n        });\n      } else if (treeData.name) {\n        allBranches['dawoud'] = treeData;\n      }\n    }\n\n    idCounter = 0;\n    Object.values(allBranches).forEach(branchRoot => {\n      if (branchRoot && typeof branchRoot === 'object') assignIds(branchRoot, 0);\n    });\n\n    currentBranchKey = 'dawoud';\n    activeTree = allBranches[currentBranchKey] || Object.values(allBranches)[0];\n    currentPath = [activeTree];\n\n    buildFlatIndex();\n    rebuildSidebar();\n    renderPage();\n\n    const splash = document.getElementById('splash');\n    splash.classList.add('hidden');\n    setTimeout(() => { splash.style.display = 'none'; }, 650);\n    showScreen('branchSelect');\n\n  } catch (error) {\n    alert('\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u062e\u0627\u0637\u0626\u0629\u060c \u0623\u0648 \u0627\u0644\u062e\u0627\u062f\u0645 \u0627\u0644\u0645\u062d\u0644\u064a \u0644\u0627 \u064a\u0639\u0645\u0644!');\n  }\n};\n/* ---------------- Header-left dropdown menu ---------------- */\nconst headerLeftWrap = document.getElementById('headerLeftWrap');\nconst headerLeftBtn = document.getElementById('headerLeftBtn');\nconst headerDropdown = document.getElementById('headerDropdown');\n\nfunction openHeaderDropdown(){\n  headerLeftWrap.classList.add('open');\n  headerLeftBtn.setAttribute('aria-expanded', 'true');\n}\nfunction closeHeaderDropdown(){\n  headerLeftWrap.classList.remove('open');\n  headerLeftBtn.setAttribute('aria-expanded', 'false');\n}\nheaderLeftBtn.addEventListener('click', () => {\n  headerLeftWrap.classList.contains('open') ? closeHeaderDropdown() : openHeaderDropdown();\n});\nheaderLeftBtn.addEventListener('keydown', (e) => {\n  if(e.key === 'Enter' || e.key === ' '){\n    e.preventDefault();\n    headerLeftWrap.classList.contains('open') ? closeHeaderDropdown() : openHeaderDropdown();\n  }\n  if(e.key === 'Escape') closeHeaderDropdown();\n});\ndocument.addEventListener('click', (e) => {\n  if(!headerLeftWrap.contains(e.target)) closeHeaderDropdown();\n});\nheaderDropdown.querySelectorAll('.header-dropdown-item').forEach(item => {\n  item.addEventListener('click', (e) => {\n    e.stopPropagation();\n    if(item.dataset.action === 'home'){\n      // 1. \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0646\u0633\u062f\u0644\u0629\n      closeHeaderDropdown();\n\n      // 2. \u0625\u062e\u0641\u0627\u0621 \u0634\u0627\u0634\u0629 \u0627\u0644\u0634\u062c\u0631\u0629 \u0648\u0634\u0627\u0634\u0629 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0623\u0641\u062e\u0627\u0630\n      document.getElementById('app').classList.remove('app-visible');\n      document.getElementById('app').style.display = 'none';\n      document.getElementById('branchSelect').classList.remove('visible');\n      document.getElementById('branchPlaceholder').classList.remove('visible');\n\n      // 3. \u0625\u0638\u0647\u0627\u0631 \u0635\u0641\u062d\u0629 \u0627\u0644\u0628\u062f\u0627\u064a\u0629 (\u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0632\u0631 \u062f\u062e\u0648\u0644)\n      const splash = document.getElementById('splash');\n      splash.style.display = 'flex'; // \u0625\u0631\u062c\u0627\u0639\u0647\u0627 \u0644\u062a\u063a\u0637\u064a \u0627\u0644\u0634\u0627\u0634\u0629\n      \n      // \u0645\u0647\u0644\u0629 \u0632\u0645\u0646\u064a\u0629 \u0642\u0635\u064a\u0631\u0629 \u062c\u062f\u0627\u064b \u0644\u0636\u0645\u0627\u0646 \u0639\u0645\u0644 \u062a\u0623\u062b\u064a\u0631 \u0627\u0644\u0638\u0647\u0648\u0631 \u0628\u0646\u0639\u0648\u0645\u0629\n      setTimeout(() => {\n        splash.classList.remove('hidden');\n      }, 10);\n    }else if(item.dataset.branch){\n      selectBranch(item.dataset.branch);\n    }\n  });\n});\n\n/* ---------------- Scroll-reveal animation (both directions) ---------------- */\nconst revealObserver = new IntersectionObserver((entries) => {\n  entries.forEach(entry => {\n    entry.target.classList.toggle('in-view', entry.isIntersecting);\n  });\n}, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });\n\nfunction observeReveal(container){\n  container.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));\n}\n\n/* ---------------- Help Modal (\u062f\u0644\u064a\u0644 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629) ---------------- */\nconst helpModal = document.getElementById('helpModal');\nconst openHelpBtn = document.getElementById('openHelpBtn');\nconst closeHelpBtn = document.getElementById('closeHelpBtn');\n\n// \u0641\u062a\u062d \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0645\u0639 \u0623\u0646\u064a\u0645\u064a\u0634\u0646 \u0627\u0644\u0646\u0628\u0636 \u0644\u0644\u0632\u0631\nopenHelpBtn.addEventListener('click', () => {\n  openHelpBtn.classList.add('btn-pop');\n  setTimeout(() => {\n    openHelpBtn.classList.remove('btn-pop');\n  }, 300);\n  \n  helpModal.classList.add('active');\n});\n\n// \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0632\u0631\ncloseHelpBtn.addEventListener('click', () => {\n  helpModal.classList.remove('active');\n});\n\n// \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u062e\u0627\u0631\u062c\u0647\nhelpModal.addEventListener('click', (e) => {\n  if(e.target === helpModal){\n    helpModal.classList.remove('active');\n  }\n});\n\n\n/* ---------------- \u0637\u0628\u0627\u0639\u0629 \u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u0646\u0633\u0628 (\u062f\u0639\u0645 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629 \u0648\u062a\u0627\u0631\u064a\u062e\u064a\u0646) ---------------- */\ndocument.getElementById('printBtn').addEventListener('click', () => {\n  const printArea = document.getElementById('printArea');\n  printArea.innerHTML = ''; \n\n  const focus = currentFocus(); \n\n  const title = document.createElement('h2');\n  title.className = 'print-title';\n// \u0646\u0646\u0634\u0626 \u0627\u0644\u0647\u064a\u0643\u0644 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 innerHTML \u0628\u062f\u0648\u0646 \u0625\u062f\u062e\u0627\u0644 \u0623\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u062e\u0637\u064a\u0631\u0629 \u0641\u064a\u0647\ntitle.innerHTML = `\u0634\u062c\u0631\u0629 \u0639\u0627\u0626\u0644\u0629 \u0627\u0644\u0642\u0648\u0627\u0633\u0645\u064a<br><span style=\"font-size:16px; color:#7c6c53; font-family:'Cairo', sans-serif;\">\u0648\u062b\u064a\u0642\u0629 \u0625\u062b\u0628\u0627\u062a \u062a\u0633\u0644\u0633\u0644 \u0646\u0633\u0628: <span id=\"safeName\"></span></span>`;\n\n// \u062b\u0645 \u0646\u062d\u0642\u0646 \u0627\u0644\u0627\u0633\u0645 \u0643\u0640 \"\u0646\u0635 \u0645\u064a\u062a\" \u062f\u0627\u062e\u0644 \u0627\u0644\u0639\u0646\u0635\u0631 \u0627\u0644\u0622\u0645\u0646 safeName\ntitle.querySelector('#safeName').textContent = focus.name;  printArea.appendChild(title);\n\n  const stem = document.createElement('div');\n  stem.className = 'lineage-stem';\n\n  const reversedPath = [...currentPath].reverse();\n\n  reversedPath.forEach((node, index) => {\n    const leaf = document.createElement('div');\n    leaf.className = 'leaf-item';\n    \n    if(index === 0) leaf.classList.add('focus-leaf');\n    if(index === reversedPath.length - 1) leaf.classList.add('root-leaf');\n\n    leaf.textContent = node.name;\n    stem.appendChild(leaf);\n\n    if (index < reversedPath.length - 1) {\n      const ben = document.createElement('div');\n      ben.className = 'ben-label';\n      ben.innerHTML = '\u0628\u0640\u0646';\n      stem.appendChild(ben);\n    }\n  });\n\n  printArea.appendChild(stem);\n\n  const footer = document.createElement('div');\n  footer.className = 'print-footer';\n  \n  // \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\n  const optionsAr = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };\n  const dateAr = new Date().toLocaleDateString('ar-JO', optionsAr);\n  \n  // \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629\n  const optionsEn = { year: 'numeric', month: 'short', day: 'numeric' };\n  const dateEn = new Date().toLocaleDateString('en-GB', optionsEn);\n  \n  // \u062f\u0645\u062c \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0646 \u0641\u064a \u0633\u0637\u0631 \u0627\u0644\u062a\u0630\u064a\u064a\u0644\n // \u062f\u0645\u062c \u0639\u062f\u062f \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0648\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0641\u064a \u0633\u0637\u0631 \u0627\u0644\u062a\u0630\u064a\u064a\u0644 (\u0628\u0627\u0644\u0646\u0635\u0641 \u062a\u062d\u062a)\n  footer.innerHTML = `\u0639\u062f\u062f \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u062f\u0627\u062e\u0644 \u0627\u0644\u0634\u062c\u0631\u0629: <span style=\"font-weight:bold; color:#8a5f2e;\">${countAll(activeTree)} \u0641\u0631\u062f</span><br>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631: ${dateAr}`;\n  footer.style.textAlign = 'center'; // \u0625\u062c\u0628\u0627\u0631 \u0627\u0644\u0646\u0635 \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0633\u064a\u0637\n  printArea.appendChild(footer);\n\n  setTimeout(() => window.print(), 300);\n});\n\n/* ---------------- Init ---------------- */\nrebuildSidebar();\nrenderPage();\n\n\n/* ---------------- Init ---------------- */\nrebuildSidebar();\nrenderPage();\n\n/* ---------------- \u0644\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 \u0627\u0633\u0645 \u0627\u0644\u0645\u0637\u0648\u0631 (\u064a\u0646\u0627\u0644) ---------------- */\ndocument.getElementById('developerLink').addEventListener('click', () => {\n  // 1. \u0646\u0628\u062d\u062b \u0639\u0646 \u0627\u0633\u0645 \"\u0627\u0644\u0633\u064a\u062f \u064a\u0646\u0627\u0644\" \u0648\u0627\u0633\u0645 \u0627\u0644\u0623\u0628 \"\u0627\u0644\u0633\u064a\u062f \u0633\u0641\u064a\u0627\u0646\" \u0641\u064a \u0627\u0644\u0641\u0647\u0631\u0633 \u0644\u0636\u0645\u0627\u0646 \u0627\u0644\u062f\u0642\u0629\n  const yanalNode = flatIndex.find(item => item.name === '\u064a\u0646\u0627\u0644' && item.father === '\u0633\u0641\u064a\u0627\u0646');\n  \n  if (yanalNode) {\n    // 2. \u0625\u0630\u0627 \u0648\u062c\u062f\u0646\u0627 \u0627\u0644\u0627\u0633\u0645\u060c \u0646\u0646\u062a\u0642\u0644 \u0625\u0644\u064a\u0647 \u0645\u0628\u0627\u0634\u0631\u0629\n    navigateToNodeId(yanalNode.id);\n    \n    // 3. \u0646\u0642\u0648\u0645 \u0628\u0627\u0644\u062a\u0645\u0631\u064a\u0631 \u0644\u0623\u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0628\u0633\u0644\u0627\u0633\u0629 \u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u0628\u0637\u0627\u0642\u0629\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n  } else {\n    // \u0631\u0633\u0627\u0644\u0629 \u062a\u0646\u0628\u064a\u0647 \u0641\u064a \u062d\u0627\u0644 \u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u0645 (\u0644\u0644\u062d\u0645\u0627\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u062e\u0637\u0627\u0621)\n    console.log(\"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0633\u0645 \u0627\u0644\u0645\u0637\u0648\u0631 \u0641\u064a \u0627\u0644\u0634\u062c\u0631\u0629\");\n  }\n});\n\n/* ---------------- Color Legend Modal ---------------- */\nconst legendModal = document.getElementById('legendModal');\nconst openLegendBtn = document.getElementById('openLegendBtn');\nconst closeLegendBtn = document.getElementById('closeLegendBtn');\n\n// \u0641\u062a\u062d \u0627\u0644\u0635\u0646\u062f\u0648\u0642\n// \u0641\u062a\u062d \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0645\u0639 \u0623\u0646\u064a\u0645\u064a\u0634\u0646 \u0644\u0644\u0632\u0631\nopenLegendBtn.addEventListener('click', () => {\n  // 1. \u0625\u0636\u0627\u0641\u0629 \u0643\u0644\u0627\u0633 \u0627\u0644\u062d\u0631\u0643\u0629 \u0644\u0644\u0632\u0631\n  openLegendBtn.classList.add('btn-pop');\n  \n  // \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0643\u0644\u0627\u0633 \u0628\u0639\u062f \u062b\u0644\u062b \u062b\u0627\u0646\u064a\u0629 (\u0644\u0643\u064a \u064a\u0639\u0645\u0644 \u0627\u0644\u0623\u0646\u064a\u0645\u064a\u0634\u0646 \u0645\u062c\u062f\u062f\u0627\u064b \u0641\u064a \u0627\u0644\u0645\u0631\u0627\u062a \u0627\u0644\u0642\u0627\u062f\u0645\u0629)\n  setTimeout(() => {\n    openLegendBtn.classList.remove('btn-pop');\n  }, 300);\n\n  // 2. \u0625\u0638\u0647\u0627\u0631 \u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0623\u0644\u0648\u0627\u0646\n  legendModal.classList.add('active');\n});\n\n// \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0625\u063a\u0644\u0627\u0642\ncloseLegendBtn.addEventListener('click', () => {\n  legendModal.classList.remove('active');\n});\n\n// \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0625\u0630\u0627 \u0636\u063a\u0637 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0623\u064a \u0645\u0643\u0627\u0646 \u0641\u0627\u0631\u063a \u062e\u0627\u0631\u062c\u0647\nlegendModal.addEventListener('click', (e) => {\n  if(e.target === legendModal){\n    legendModal.classList.remove('active');\n  }\n});\n\n/* ============ \u0631\u0633\u0645 \u0627\u0644\u0634\u062c\u0631\u0629 \u0627\u0644\u0639\u0636\u0648\u064a\u0629 (\u0646\u0633\u062e\u0629 \u0645\u062a\u0642\u0627\u0631\u0628\u0629\u060c \u0623\u0648\u0631\u0627\u0642 \u0643\u0628\u064a\u0631\u0629\u060c \u0648\u0646\u0635\u0648\u0635 \u062f\u0642\u064a\u0642\u0629) ============ */\nconst vtModal = document.getElementById('visualTreeModal');\nconst vtCanvas = document.getElementById('visualTreeCanvas');\n\n/* Mini-map state: recomputed every time the tree is (re)rendered or resized */\nlet mmState = null;\nlet lastMmArgs = null;\n\nfunction openVisualTree(rootData) {\n  vtModal.classList.add('active');\n  document.getElementById('vtTitle').textContent = `\u0634\u062c\u0631\u0629 \u0646\u0633\u0628: ${rootData.name}`;\n  vtCanvas.innerHTML = ''; \n\n  const root = d3.hierarchy(rootData);\n  \n  // 1. Dynamic Spacing Logic\n  const totalLeaves = root.leaves().length;\n  const maxTreeDepth = root.height;\n  \n  // Scale down dx if there are many leaves to prevent massive horizontal spread\n  // Scale down dy based on depth to keep the view tight\nconst dx = Math.max(400, 500 - (totalLeaves * 6)); \nconst dy = Math.max(750, 1150 - (maxTreeDepth * 55));\n  \n  const tree = d3.tree().nodeSize([dx, dy]);\n  tree(root);\n\n  let x0 = Infinity, x1 = -x0, y0 = Infinity, y1 = -y0;\n  root.each(d => {\n    if (d.x > x1) x1 = d.x; if (d.x < x0) x0 = d.x;\n    if (d.y > y1) y1 = d.y; if (d.y < y0) y0 = d.y;\n  });\n\n  const treeWidth = x1 - x0 + dx * 2;\n  const treeHeight = y1 - y0 + dy * 2;\n\nconst svg = d3.select(\"#visualTreeCanvas\").append(\"svg\")\n      .attr(\"width\", \"100%\")\n      .attr(\"height\", \"100%\")\n      // \u062a\u0645 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u062b\u0627\u0628\u062a \u0644\u064a\u0623\u062e\u0630 \u0644\u0648\u0646 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u062d\u0633\u0628 \u0627\u0644\u0648\u0636\u0639 (\u0644\u064a\u0644\u064a/\u0646\u0647\u0627\u0631\u064a)\n      .style(\"background\", \"var(--paper)\")\n      .style(\"cursor\", \"grab\")\n      .attr(\"data-x0\", x0)\n      .attr(\"data-x1\", x1)\n      .attr(\"data-y0\", y0)\n      .attr(\"data-y1\", y1);\n\n  const g = svg.append(\"g\");\n\n  const zoom = d3.zoom()\n      .scaleExtent([0.05, 3]) \n      .on(\"zoom\", (event) => {\n          g.attr(\"transform\", event.transform);\n          updateMinimapViewport(event.transform);\n      });\n\n  svg.call(zoom);\n\n  // 2. \u0631\u0633\u0645 \u0627\u0644\u0641\u0631\u0648\u0639\n  g.append(\"g\")\n    .attr(\"fill\", \"none\")\n    .attr(\"stroke\", \"#7ba869\")\n    .attr(\"stroke-width\", 10) \n    .selectAll(\"path\")\n    .data(root.links())\n    .join(\"path\")\n    .attr(\"d\", d3.linkVertical()\n        .x(d => d.x)\n        .y(d => d.y));\n\n  // 3. \u0631\u0633\u0645 \u0627\u0644\u0623\u0648\u0631\u0627\u0642 \u0627\u0644\u0645\u0643\u0628\u0631\u0629\n  const node = g.append(\"g\")\n    .selectAll(\"g\")\n    .data(root.descendants())\n    .join(\"g\")\n    .attr(\"transform\", d => `translate(${d.x},${d.y})`);\n\n  const leafPath = \"M0,20 C-25,10 -30,-20 0,-40 C30,-20 25,10 0,20 Z\";\n\n  node.append(\"path\")\n      .attr(\"d\", leafPath)\n      .attr(\"fill\", d => d.depth === 0 ? \"url(#goldGrad)\" : \"#3a5c30\")\n      .attr(\"stroke\", d => d.depth === 0 ? \"#8a5f2e\" : \"#2d4a25\")\n      .attr(\"stroke-width\", 2)\n      .attr(\"transform\", d => {\n          // \u062a\u0643\u0628\u064a\u0631 \u062d\u062c\u0645 \u0627\u0644\u0623\u0648\u0631\u0627\u0642 \u0645\u0639 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0645\u064a\u0644\u0627\u0646\n          if (d.depth === 0) return \"scale(13)\"; // \u0648\u0631\u0642\u0629 \u0627\u0644\u062c\u062f \u0636\u062e\u0645\u0629\n          return d.x < 0 ? \"scale(10) rotate(-25)\" : \"scale(10) rotate(25)\"; // \u0623\u0648\u0631\u0627\u0642 \u0627\u0644\u0623\u0628\u0646\u0627\u0621 \u0643\u0628\u064a\u0631\u0629\n      })\n      .style(\"filter\", \"drop-shadow(0px 6px 10px rgba(0,0,0,0.15))\"); \n\n  const defs = svg.append(\"defs\");\n  const grad = defs.append(\"linearGradient\")\n      .attr(\"id\", \"goldGrad\").attr(\"x1\", \"0%\").attr(\"y1\", \"0%\").attr(\"x2\", \"100%\").attr(\"y2\", \"100%\");\n  grad.append(\"stop\").attr(\"offset\", \"0%\").style(\"stop-color\", \"#d3a765\");\n  grad.append(\"stop\").attr(\"offset\", \"100%\").style(\"stop-color\", \"#8a5f2e\");\n\n  // 4. \u0636\u0628\u0637 \u0627\u0644\u0646\u0635\u0648\u0635 \u0648\u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u062f\u0627\u062e\u0644 \u0627\u0644\u0623\u0648\u0631\u0627\u0642\n  node.append(\"text\")\n      .attr(\"dy\", \"0.35em\")\n      .attr(\"fill\", d => d.depth === 0 ? \"#fff\" : \"#f7f1e2\")\n      .attr(\"font-family\", \"'Dubai', 'Segoe UI', Tahoma, sans-serif\") // \u0625\u062c\u0628\u0627\u0631 \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062e\u0637 \u0627\u0644\u0639\u0631\u0628\u064a\n      .attr(\"font-size\", d => d.depth === 0 ? \"120px\" : \"100px\") // \u0623\u062d\u062c\u0627\u0645 \u062e\u0637\u0648\u0637 \u0645\u062f\u0631\u0648\u0633\u0629 \u0644\u062a\u062a\u0633\u0639 \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u0631\u0642\u0629\n      .attr(\"font-weight\", \"800\")\n      .style(\"text-anchor\", \"middle\")\n      // \u0627\u0644\u0633\u0631 \u0647\u0646\u0627: \u062c\u0639\u0644\u0646\u0627 \u0627\u0644\u0646\u0635 \u0623\u0641\u0642\u064a\u0627\u064b \u062a\u0645\u0627\u0645\u0627\u064b\u060c \u0648\u0642\u0645\u0646\u0627 \u0628\u0625\u0632\u0627\u062d\u062a\u0647 \u0644\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0644\u0644\u0648\u0631\u0642\u0629\n      .attr(\"transform\", d => {\n          if (d.depth === 0) return \"translate(5, -95)\"; // \u0631\u0641\u0639 \u0627\u0644\u0646\u0635 \u0644\u0645\u0646\u062a\u0635\u0641 \u0648\u0631\u0642\u0629 \u0627\u0644\u062c\u062f\n          return d.x < 0 ? \"translate(-18, -70)\" : \"translate(18, -70)\"; // \u062a\u0648\u0633\u064a\u0637 \u0627\u0644\u0646\u0635 \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0627\u0626\u0644\u0629\n      })\n      .text(d => d.data.name);\n\n  // \u0627\u062d\u062a\u0648\u0627\u0621 \u0627\u0644\u0634\u062c\u0631\u0629 \u0641\u064a \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0634\u0627\u0634\u0629 \u0639\u0646\u062f \u0627\u0644\u0641\u062a\u062d\n  const clientWidth = vtCanvas.clientWidth;\n  const clientHeight = vtCanvas.clientHeight;\n  const initialScale = Math.min(clientWidth / treeWidth, clientHeight / treeHeight, 1) * 0.95; \n  \n  const initialX = (clientWidth - (x1 + x0) * initialScale) / 2;\n  const initialY = (clientHeight - (y1 + y0) * initialScale) / 2;\n  \n  svg.call(zoom.transform, d3.zoomIdentity.translate(initialX, initialY).scale(initialScale));\n\n  // 5. \u0628\u0646\u0627\u0621 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629 (Mini-map) \u0648\u0645\u0632\u0627\u0645\u0646\u062a\u0647\u0627 \u0645\u0639 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\n  lastMmArgs = { root, x0, x1, y0, y1, treeWidth, treeHeight, svg, zoom };\n  buildMinimap(root, x0, x1, y0, y1, svg, zoom);\n  updateMinimapViewport(d3.zoomIdentity.translate(initialX, initialY).scale(initialScale));\n}\n/* ============ Mini-map: \u0646\u0638\u0631\u0629 \u0639\u0627\u0645\u0629 \u0645\u0635\u063a\u0651\u0631\u0629 + \u0645\u0624\u0634\u0631 \u062a\u0646\u0642\u0651\u0644 + \u0642\u0641\u0632 \u0645\u0628\u0627\u0634\u0631 ============ */\n\n// \u064a\u0631\u0633\u0645 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 (\u0631\u0648\u0627\u0628\u0637 + \u0639\u0642\u062f) \u0639\u0644\u0649 Canvas \u0644\u0623\u062f\u0627\u0621 \u0633\u0631\u064a\u0639 \u062d\u062a\u0649 \u0645\u0639 \u0622\u0644\u0627\u0641 \u0627\u0644\u0623\u0633\u0645\u0627\u0621\nfunction buildMinimap(root, x0, x1, y0, y1, svg, zoom) {\n  const wrap = document.getElementById('minimapWrap');\n  const canvas = document.getElementById('minimapCanvas');\n  if (!wrap || !canvas) return;\n\n  wrap.style.display = 'block';\n\n  const cw = wrap.clientWidth, ch = wrap.clientHeight;\n  const dpr = window.devicePixelRatio || 1;\n  canvas.width = Math.max(1, cw * dpr);\n  canvas.height = Math.max(1, ch * dpr);\n  canvas.style.width = cw + 'px';\n  canvas.style.height = ch + 'px';\n\n  const ctx = canvas.getContext('2d');\n  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  ctx.clearRect(0, 0, cw, ch);\n\n  const pad = 10;\n  const boundsW = Math.max(1, x1 - x0);\n  const boundsH = Math.max(1, y1 - y0);\n  const scale = Math.min((cw - pad * 2) / boundsW, (ch - pad * 2) / boundsH);\n  const drawnW = boundsW * scale, drawnH = boundsH * scale;\n  const offX = (cw - drawnW) / 2;\n  const offY = (ch - drawnH) / 2;\n\n  const toMmX = (tx) => offX + (tx - x0) * scale;\n  const toMmY = (ty) => offY + (ty - y0) * scale;\n\n  // \u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u062a\u064f\u0642\u0631\u0623 \u0645\u0646 \u0645\u062a\u063a\u064a\u0631\u0627\u062a CSS \u0627\u0644\u062d\u064a\u0651\u0629 \u0644\u062a\u062a\u0648\u0627\u0641\u0642 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0645\u0639 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0644\u064a\u0644\u064a\n  const styles = getComputedStyle(document.body);\n  const linkColor = (styles.getPropertyValue('--green-1') || '#7ba869').trim();\n  const rootColor = (styles.getPropertyValue('--gold-deep') || '#8a5f2e').trim();\n  const nodeColor = (styles.getPropertyValue('--green-2') || '#4c7a3f').trim();\n\n  ctx.strokeStyle = linkColor;\n  ctx.lineWidth = 1;\n  ctx.globalAlpha = 0.85;\n  root.links().forEach(link => {\n    ctx.beginPath();\n    ctx.moveTo(toMmX(link.source.x), toMmY(link.source.y));\n    ctx.lineTo(toMmX(link.target.x), toMmY(link.target.y));\n    ctx.stroke();\n  });\n\n  ctx.globalAlpha = 1;\n  root.descendants().forEach(d => {\n    ctx.beginPath();\n    ctx.fillStyle = d.depth === 0 ? rootColor : nodeColor;\n    ctx.arc(toMmX(d.x), toMmY(d.y), d.depth === 0 ? 3.5 : 2, 0, Math.PI * 2);\n    ctx.fill();\n  });\n\n  mmState = { cw, ch, pad, x0, x1, y0, y1, scale, offX, offY, toMmX, toMmY, svg, zoom };\n}\n\nfunction mmTreeXFromPx(px) { return mmState.x0 + (px - mmState.offX) / mmState.scale; }\nfunction mmTreeYFromPx(py) { return mmState.y0 + (py - mmState.offY) / mmState.scale; }\n\n// \u064a\u062d\u062f\u0651\u062b \u0645\u0633\u062a\u0637\u064a\u0644 \"\u0623\u0646\u062a \u0647\u0646\u0627\" \u0641\u064a \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0632\u0648\u0648\u0645 \u0627\u0644\u062d\u0627\u0644\u064a \u0644\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\nfunction updateMinimapViewport(transform) {\n  if (!mmState) return;\n  const viewportEl = document.getElementById('minimapViewport');\n  if (!viewportEl) return;\n\n  const cw = vtCanvas.clientWidth, ch = vtCanvas.clientHeight;\n  const k = transform.k;\n  const treeX0 = -transform.x / k;\n  const treeY0 = -transform.y / k;\n  const treeX1 = (cw - transform.x) / k;\n  const treeY1 = (ch - transform.y) / k;\n\n  let px0 = mmState.toMmX(treeX0);\n  let py0 = mmState.toMmY(treeY0);\n  let px1 = mmState.toMmX(treeX1);\n  let py1 = mmState.toMmY(treeY1);\n\n  // \u0646\u0642\u0635\u0651 \u0627\u0644\u0645\u0633\u062a\u0637\u064a\u0644 \u0639\u0644\u0649 \u062d\u062f\u0648\u062f \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629 \u062d\u062a\u0649 \u0644\u0627 \u064a\u0641\u064a\u0636 \u0628\u0635\u0631\u064a\u0627\u064b\n  px0 = Math.max(0, Math.min(mmState.cw, px0));\n  px1 = Math.max(0, Math.min(mmState.cw, px1));\n  py0 = Math.max(0, Math.min(mmState.ch, py0));\n  py1 = Math.max(0, Math.min(mmState.ch, py1));\n\n  viewportEl.style.left = px0 + 'px';\n  viewportEl.style.top = py0 + 'px';\n  viewportEl.style.width = Math.max(4, px1 - px0) + 'px';\n  viewportEl.style.height = Math.max(4, py1 - py0) + 'px';\n}\n\n// \u064a\u0646\u0642\u0644 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0641\u0648\u0631\u0627\u064b (\u0628\u062f\u0648\u0646 \u0623\u0646\u064a\u0645\u064a\u0634\u0646) \u2014 \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0633\u062d\u0628 \u0644\u0636\u0645\u0627\u0646 \u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0633\u0644\u0633\u0629\nfunction navigateMinimapInstant(px, py) {\n  if (!mmState) return;\n  const cw = vtCanvas.clientWidth, ch = vtCanvas.clientHeight;\n  const treeX = mmTreeXFromPx(px);\n  const treeY = mmTreeYFromPx(py);\n  const k = d3.zoomTransform(mmState.svg.node()).k;\n  const tx = cw / 2 - treeX * k;\n  const ty = ch / 2 - treeY * k;\n  mmState.svg.call(mmState.zoom.transform, d3.zoomIdentity.translate(tx, ty).scale(k));\n}\n\n// \u064a\u0646\u0642\u0644 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0628\u0623\u0646\u064a\u0645\u064a\u0634\u0646 \u0633\u0644\u0633 \u2014 \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0639\u0646\u062f \u0627\u0644\u0646\u0642\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629\nfunction navigateMinimapAnimated(px, py) {\n  if (!mmState) return;\n  const cw = vtCanvas.clientWidth, ch = vtCanvas.clientHeight;\n  const treeX = mmTreeXFromPx(px);\n  const treeY = mmTreeYFromPx(py);\n  const k = d3.zoomTransform(mmState.svg.node()).k;\n  const tx = cw / 2 - treeX * k;\n  const ty = ch / 2 - treeY * k;\n  mmState.svg.transition().duration(300).call(\n    mmState.zoom.transform,\n    d3.zoomIdentity.translate(tx, ty).scale(k)\n  );\n}\n\n// \u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a \u0646\u0642\u0631\u0629/\u0633\u062d\u0628 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0642\u0645\u0627\u0634 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629\nfunction mmPointerPos(clientX, clientY) {\n  const rect = document.getElementById('minimapCanvas').getBoundingClientRect();\n  return { px: clientX - rect.left, py: clientY - rect.top };\n}\n\nconst minimapCanvasEl = document.getElementById('minimapCanvas');\nconst minimapViewportEl = document.getElementById('minimapViewport');\n\n// \u0646\u0642\u0631 \u0645\u0628\u0627\u0634\u0631 \u0641\u064a \u0623\u064a \u0645\u0646\u0637\u0642\u0629 \u0645\u0646 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 => \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u064a\u0647\u0627 \u0641\u0648\u0631\u0627\u064b \u0641\u064a \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\nminimapCanvasEl.addEventListener('click', (e) => {\n  const { px, py } = mmPointerPos(e.clientX, e.clientY);\n  navigateMinimapAnimated(px, py);\n});\n\n// \u0633\u062d\u0628 \u0645\u0633\u062a\u0637\u064a\u0644 \"\u0623\u0646\u062a \u0647\u0646\u0627\" \u0644\u0644\u062a\u0646\u0642\u0651\u0644 \u0628\u062d\u0631\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0634\u062c\u0631\u0629\nlet mmDragging = false;\nminimapViewportEl.addEventListener('mousedown', (e) => {\n  mmDragging = true;\n  e.preventDefault();\n  e.stopPropagation();\n});\nwindow.addEventListener('mousemove', (e) => {\n  if (!mmDragging) return;\n  const { px, py } = mmPointerPos(e.clientX, e.clientY);\n  navigateMinimapInstant(px, py);\n});\nwindow.addEventListener('mouseup', () => { mmDragging = false; });\n\n// \u062f\u0639\u0645 \u0627\u0644\u0644\u0645\u0633 \u0639\u0644\u0649 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0644\u0648\u062d\u064a\u0629 \u0648\u0627\u0644\u0647\u0648\u0627\u062a\u0641\nminimapViewportEl.addEventListener('touchstart', (e) => {\n  mmDragging = true;\n  e.stopPropagation();\n}, { passive: true });\nwindow.addEventListener('touchmove', (e) => {\n  if (!mmDragging || !e.touches.length) return;\n  const t = e.touches[0];\n  const { px, py } = mmPointerPos(t.clientX, t.clientY);\n  navigateMinimapInstant(px, py);\n}, { passive: true });\nwindow.addEventListener('touchend', () => { mmDragging = false; });\nminimapCanvasEl.addEventListener('touchstart', (e) => {\n  if (!e.touches.length) return;\n  const t = e.touches[0];\n  const { px, py } = mmPointerPos(t.clientX, t.clientY);\n  navigateMinimapAnimated(px, py);\n}, { passive: true });\n\n// \u0625\u0639\u0627\u062f\u0629 \u0631\u0633\u0645 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0639\u0646\u062f \u062a\u063a\u064a\u064a\u0631 \u062d\u062c\u0645 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0623\u062b\u0646\u0627\u0621 \u0641\u062a\u062d \u0627\u0644\u0634\u062c\u0631\u0629 (\u064a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u062f\u0642\u0629 \u0627\u0644\u0645\u0624\u0634\u0631)\nwindow.addEventListener('resize', () => {\n  if (vtModal.classList.contains('active') && lastMmArgs) {\n    buildMinimap(lastMmArgs.root, lastMmArgs.x0, lastMmArgs.x1, lastMmArgs.y0, lastMmArgs.y1, lastMmArgs.svg, lastMmArgs.zoom);\n    updateMinimapViewport(d3.zoomTransform(lastMmArgs.svg.node()));\n  }\n});\n\n// \u0632\u0631 \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0646\u0627\u0641\u0630\u0629\ndocument.getElementById('closeTreeBtn').addEventListener('click', () => {\n  vtModal.classList.remove('active');\n});\n/* ============ \u062e\u0644\u0641\u064a\u0629 \u0632\u062e\u0631\u0641\u064a\u0629 \u0623\u0646\u064a\u0642\u0629 \u0648\u062e\u0641\u064a\u0641\u0629 \u0644\u0648\u062b\u064a\u0642\u0629 \u0627\u0644\u0637\u0628\u0627\u0639\u0629 (\u0628\u062f\u064a\u0644 \u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0631\u0645\u0627\u062f\u064a \u0627\u0644\u0623\u0645\u0644\u0633) ============ */\nfunction drawDecorativePrintBackground(ctx, w, h) {\n  // 1) \u0642\u0627\u0639\u062f\u0629 \u0644\u0648\u0646 \u0627\u0644\u0648\u0631\u0642 \u0627\u0644\u062f\u0627\u0641\u0626 \u2014 \u0646\u0641\u0633 \u0647\u0648\u064a\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\n  ctx.fillStyle = '#fffdf8';\n  ctx.fillRect(0, 0, w, h);\n\n  // 2) \u062a\u0648\u0647\u0651\u062c\u0627\u0646 \u0644\u0648\u0646\u064a\u0627\u0646 \u0646\u0627\u0639\u0645\u0627\u0646 (\u0630\u0647\u0628\u064a \u0648\u0623\u062e\u0636\u0631) \u064a\u0639\u0643\u0633\u0627\u0646 \u0647\u0648\u064a\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062f\u0648\u0646 \u0623\u0646 \u064a\u0634\u062a\u062a\u0627 \u0627\u0644\u0627\u0646\u062a\u0628\u0627\u0647 \u0639\u0646 \u0627\u0644\u0634\u062c\u0631\u0629\n  const bloomTL = ctx.createRadialGradient(w * 0.07, h * 0.05, 0, w * 0.07, h * 0.05, Math.max(w, h) * 0.55);\n  bloomTL.addColorStop(0, 'rgba(201,151,79,0.16)');\n  bloomTL.addColorStop(1, 'rgba(201,151,79,0)');\n  ctx.fillStyle = bloomTL;\n  ctx.fillRect(0, 0, w, h);\n\n  const bloomBR = ctx.createRadialGradient(w * 0.95, h * 0.96, 0, w * 0.95, h * 0.96, Math.max(w, h) * 0.55);\n  bloomBR.addColorStop(0, 'rgba(76,122,63,0.13)');\n  bloomBR.addColorStop(1, 'rgba(76,122,63,0)');\n  ctx.fillStyle = bloomBR;\n  ctx.fillRect(0, 0, w, h);\n\n \n\n  // 4) \u062a\u0638\u0644\u064a\u0644 \u0646\u0627\u0639\u0645 \u0639\u0644\u0649 \u0627\u0644\u0623\u0637\u0631\u0627\u0641 (Vignette) \u064a\u0648\u062c\u0651\u0647 \u0627\u0644\u0639\u064a\u0646 \u0646\u062d\u0648 \u0645\u0631\u0643\u0632 \u0627\u0644\u0634\u062c\u0631\u0629 \u2014 \u062a\u0642\u0646\u064a\u0629 \u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629 \u0641\u064a \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0637\u0628\u0627\u0639\u0629\n  const vignette = ctx.createRadialGradient(w / 2, h / 2, Math.min(w, h) * 0.38, w / 2, h / 2, Math.max(w, h) * 0.74);\n  vignette.addColorStop(0, 'rgba(58,44,30,0)');\n  vignette.addColorStop(1, 'rgba(58,44,30,0.055)');\n  ctx.fillStyle = vignette;\n  ctx.fillRect(0, 0, w, h);\n}\n\n/* ============ \u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u0634\u062c\u0631\u0629 \u0643\u0645\u0644\u0641 PDF (\u0627\u0644\u062d\u0644 \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0644\u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u0642\u0635 \u0648\u0627\u0644\u0640 RTL) ============ */\ndocument.getElementById('exportTreeBtn').addEventListener('click', async () => {\n  const userConsent = confirm(\"\u0647\u0644 \u062a\u0631\u063a\u0628 \u0641\u064a \u062d\u0641\u0638 \u0647\u0630\u0647 \u0627\u0644\u0634\u062c\u0631\u0629 \u0643\u0645\u0644\u0641 PDF \u0639\u0627\u0644\u064a \u0627\u0644\u062f\u0642\u0629\u061f\");\n  if (!userConsent) return;\n\n  await document.fonts.ready;\n\n  const liveSvg = document.querySelector('#visualTreeCanvas svg');\n  if (!liveSvg) {\n    alert(\"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0634\u062c\u0631\u0629.\");\n    return;\n  }\n\n  try {\n    const liveG = liveSvg.querySelector('g');\n\n    // 1. \u0639\u062f\u0651 \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0638\u0627\u0647\u0631\u064a\u0646 \u0641\u0639\u0644\u064a\u0627\u064b \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0648\u062b\u064a\u0642\u0629 (\u0645\u0646 \u0646\u0642\u0627\u0637 \u062a\u0645\u0648\u0636\u0639 \u0627\u0644\u0639\u0642\u062f)\n    let printedCount = 0;\n    liveG.querySelectorAll('g').forEach(node => {\n        const d = node.__data__;\n        if (d && typeof d.x === 'number') printedCount++;\n    });\n\n    // 2. \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0645\u062d\u064a\u0637 \u0627\u0644\u062d\u0642\u064a\u0642\u064a \u0644\u0644\u0631\u0633\u0645 \u2014 \u064a\u064f\u0642\u0627\u0633 \u0628\u0640 getBBox() \u0641\u064a\u0634\u0645\u0644 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b\n    //    \u062d\u062c\u0645 \u0627\u0644\u0623\u0648\u0631\u0627\u0642 \u0627\u0644\u0645\u0643\u0628\u0651\u0631\u0629 (scale) \u0648\u0627\u0644\u0646\u0635\u0648\u0635\u060c \u0628\u062e\u0644\u0627\u0641 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0646\u0642\u0627\u0637 \u062a\u0645\u0648\u0636\u0639\n    //    \u0627\u0644\u0639\u0642\u062f \u0641\u0642\u0637 \u0648\u0627\u0644\u062a\u064a \u0643\u0627\u0646\u062a \u062a\u062a\u062c\u0627\u0647\u0644 \u0627\u0645\u062a\u062f\u0627\u062f \u0627\u0644\u0634\u0643\u0644 \u0627\u0644\u0641\u0639\u0644\u064a \u0641\u0648\u0642/\u062d\u0648\u0644 \u0646\u0642\u0637\u0629 \u0627\u0644\u0627\u0631\u062a\u0643\u0627\u0632\n    const bbox = liveG.getBBox();\n    let minX = bbox.x, maxX = bbox.x + bbox.width;\n    let minY = bbox.y, maxY = bbox.y + bbox.height;\n\n    if (!isFinite(minX) || bbox.width === 0) { minX = 0; maxX = 1000; minY = 0; maxY = 1000; }\n\n    const clonedSvg = liveSvg.cloneNode(true);\n    const clonedG = clonedSvg.querySelector('g');\n\n    // ==========================================\n    // \ud83c\udf1f \u0627\u0644\u0633\u0631 \u0647\u0646\u0627: \u0625\u062c\u0628\u0627\u0631 \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0624\u0642\u062a\u0629 \u0639\u0644\u0649 \u0646\u0638\u0627\u0645 LTR \ud83c\udf1f\n    // \u0647\u0630\u0627 \u064a\u0645\u0646\u0639 \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0645\u0646 \u0639\u0643\u0633 \u0627\u0644\u0634\u062c\u0631\u0629 \u0648\u0642\u0635 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u064a\u0645\u0646\u0649\n    // ==========================================\n    clonedSvg.setAttribute(\"dir\", \"ltr\");\n    clonedSvg.style.direction = \"ltr\";\n\n    // 2. \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u062e\u0637\n    const styleElement = document.createElementNS(\"http://www.w3.org/2000/svg\", \"style\");\n    styleElement.textContent = `\n      text {\n        font-family: 'Dubai', 'Segoe UI', Tahoma, sans-serif !important;\n        font-weight: bold !important;\n      }\n    `;\n    clonedSvg.prepend(styleElement);\n\n    // 3. \u0647\u0648\u0627\u0645\u0634 \u0623\u0645\u0627\u0646 \u0623\u0643\u062b\u0631 \u0625\u062d\u0643\u0627\u0645\u0627\u064b \u2014 \u062a\u0635\u0645\u064a\u0645 \u0645\u0636\u063a\u0648\u0637 \u0648\u0645\u062a\u0648\u0627\u0632\u0646 \u0644\u0644\u0637\u0628\u0627\u0639\u0629 (\u0628\u0639\u062f \u0623\u0646 \u0643\u0627\u0646\u062a 600px \u0623\u0635\u0628\u062d\u062a \u0623\u0643\u062b\u0631 \u062a\u0648\u0627\u0632\u0646\u0627\u064b)\n    //    \u0645\u0627 \u0632\u0644\u0646\u0627 \u0646\u062a\u0631\u0643 \u0645\u0633\u0627\u062d\u0629 \u0643\u0627\u0641\u064a\u0629 \u062d\u0648\u0644 \u0623\u0643\u0628\u0631 \u0648\u0631\u0642\u0629 (\u0648\u0631\u0642\u0629 \u0627\u0644\u062c\u062f) \u0644\u062a\u0641\u0627\u062f\u064a \u0623\u064a \u0642\u0635\n    const safePadding = 600;\n\n    const width = Math.ceil((maxX - minX) + (safePadding * 2));\n    const height = Math.ceil((maxY - minY) + (safePadding * 2));\n\n    // \u062a\u0648\u0633\u064a\u0637 \u0627\u0644\u0634\u062c\u0631\u0629 \u0647\u0646\u062f\u0633\u064a\u0627\u064b\n    clonedG.setAttribute('transform', `translate(${-minX + safePadding}, ${-minY + safePadding}) scale(1)`);\n    \n    // 4. \u0631\u0633\u0645 \u0625\u0637\u0627\u0631 \u0623\u0646\u064a\u0642 \u0648\u0628\u0633\u064a\u0637: \u062e\u0637 \u062e\u0627\u0631\u062c\u064a \u063a\u0644\u064a\u0638 + \u062e\u0637 \u0634\u0639\u0631\u0629 \u0648\u0633\u0637\u064a + \u062e\u0637 \u062f\u0627\u062e\u0644\u064a \u0631\u0641\u064a\u0639 + \u0632\u062e\u0627\u0631\u0641 \u0627\u0644\u0632\u0648\u0627\u064a\u0627\n    const frameMargin = 100;\n\n const outerFrame = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n    outerFrame.setAttribute(\"x\", frameMargin);\n    outerFrame.setAttribute(\"y\", frameMargin);\n    outerFrame.setAttribute(\"width\", width - (frameMargin * 2));\n    outerFrame.setAttribute(\"height\", height - (frameMargin * 2));\n    outerFrame.setAttribute(\"fill\", \"none\");\n    outerFrame.setAttribute(\"stroke\", \"#8a5f2e\");\n    outerFrame.setAttribute(\"stroke-width\", \"10\");\n    clonedSvg.appendChild(outerFrame);\n\n    const innerFrame = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n    innerFrame.setAttribute(\"x\", frameMargin + 30);\n    innerFrame.setAttribute(\"y\", frameMargin + 30);\n    innerFrame.setAttribute(\"width\", width - (frameMargin * 2) - 60);\n    innerFrame.setAttribute(\"height\", height - (frameMargin * 2) - 60);\n    innerFrame.setAttribute(\"fill\", \"none\");\n    innerFrame.setAttribute(\"stroke\", \"#c9974f\");\n    innerFrame.setAttribute(\"stroke-width\", \"4\");\n    clonedSvg.appendChild(innerFrame);\n    \n\n// --- \u0625\u0636\u0627\u0641\u0629 \u0639\u062f\u062f \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0645\u0637\u0628\u0648\u0639\u064a\u0646 \u0648\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0641\u064a \u0623\u0633\u0641\u0644 \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0634\u062c\u0631\u0629 ---\n    const todayOptions = { year: 'numeric', month: 'long', day: 'numeric' };\n    const todayDate = new Date().toLocaleDateString('ar-JO', todayOptions);\n\n    const footerInfo = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n    footerInfo.setAttribute(\"x\", (width / 2)-80); // \u062a\u0648\u0633\u064a\u0637 \u0623\u0641\u0642\u064a\n    const frameInnerEdge = frameMargin + 30; // where the innermost frame line actually sits\n    const footerClearance = 60;              // safety gap between text and that line\n    footerInfo.setAttribute(\"y\", height - frameInnerEdge - footerClearance); // \u0636\u0645\u0646 \u0627\u0644\u0634\u0631\u064a\u0637 \u0627\u0644\u0633\u0641\u0644\u064a \u0627\u0644\u0641\u0627\u0631\u063a \u0628\u064a\u0646 \u0623\u0633\u0641\u0644 \u0627\u0644\u0634\u062c\u0631\u0629 \u0648\u062e\u0637 \u0627\u0644\u0625\u0637\u0627\u0631\n    footerInfo.setAttribute(\"text-anchor\", \"middle\"); // \u0645\u062d\u0627\u0630\u0627\u0629 \u0627\u0644\u0646\u0635 \u0644\u0644\u0648\u0633\u0637\n    footerInfo.setAttribute(\"fill\", \"#8a5f2e\"); // \u0644\u0648\u0646 \u0630\u0647\u0628\u064a \u063a\u0627\u0645\u0642 \u0645\u062a\u0646\u0627\u0633\u0642 \u0645\u0639 \u0627\u0644\u0625\u0637\u0627\u0631\n    footerInfo.setAttribute(\"font-size\", \"150px\"); // \u062d\u062c\u0645 \u062e\u0637 \u0645\u0646\u0627\u0633\u0628 \u0644\u062d\u062c\u0645 \u0627\u0644\u0634\u062c\u0631\u0629\n    footerInfo.setAttribute(\"font-weight\", \"bold\");\n    footerInfo.setAttribute(\"font-family\", \"'Dubai', 'Cairo', sans-serif\");\n    // \u0646\u0639\u0631\u0636 \u0639\u062f\u062f \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0638\u0627\u0647\u0631\u064a\u0646 \u0641\u0639\u0644\u064a\u0627\u064b \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0648\u062b\u064a\u0642\u0629 (\u0648\u0644\u064a\u0633 \u0625\u062c\u0645\u0627\u0644\u064a \u0639\u062f\u062f \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0634\u062c\u0631\u0629 \u0643\u0627\u0645\u0644\u0629)\n    footerInfo.textContent = `\u0639\u062f\u062f \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0648\u062b\u064a\u0642\u0629: ${printedCount} \u0641\u0631\u062f | \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0637\u0628\u0627\u0639\u0629: ${todayDate}`;\n    clonedSvg.appendChild(footerInfo);\n    // ----------------------------------------------------\n\n    // 5. \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0645\u0642\u0627\u0633\u0627\u062a \u0648\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0645\u0644\u0641\n    clonedSvg.style.width = width + 'px';\n    clonedSvg.style.height = height + 'px';\n    clonedSvg.style.maxWidth = 'none'; \n    clonedSvg.style.maxHeight = 'none'; \n    \n    clonedSvg.setAttribute(\"xmlns\", \"http://www.w3.org/2000/svg\");\n    clonedSvg.setAttribute(\"width\", width);\n    clonedSvg.setAttribute(\"height\", height);\n    clonedSvg.setAttribute(\"viewBox\", `0 0 ${width} ${height}`);\n\n    const svgData = new XMLSerializer().serializeToString(clonedSvg);\n    const blob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });\n    const url = URL.createObjectURL(blob);\n    \n    const img = new Image();\n    img.src = url;\n\n    img.onload = function() {\n      const canvas = document.createElement(\"canvas\");\n      const MAX_CANVAS_DIMENSION = 4000;\n      let scale = 2;\n      \n      if ((width * scale) > MAX_CANVAS_DIMENSION || (height * scale) > MAX_CANVAS_DIMENSION) {\n          scale = Math.min(MAX_CANVAS_DIMENSION / width, MAX_CANVAS_DIMENSION / height);\n      }\n      \n      canvas.width = width * scale;\n      canvas.height = height * scale;\n      const ctx = canvas.getContext(\"2d\");\n      \n      drawDecorativePrintBackground(ctx, canvas.width, canvas.height);\n      \n      ctx.scale(scale, scale);\n      ctx.drawImage(img, 0, 0, width, height);\n\n      const { jsPDF } = window.jspdf;\n      const pdf = new jsPDF({\n        orientation: canvas.width > canvas.height ? 'landscape' : 'portrait',\n        unit: 'px',\n        format: [canvas.width, canvas.height]\n      });\n\n      const imgData = canvas.toDataURL(\"image/jpeg\", 0.90); \n      pdf.addImage(imgData, 'JPEG', 0, 0, canvas.width, canvas.height);\n\n      const currentName = document.getElementById('vtTitle').textContent.split(': ')[1];\n      pdf.save(`\u0634\u062c\u0631\u0629_\u0646\u0633\u0628_${currentName}.pdf`);\n\n      URL.revokeObjectURL(url);\n    };\n\n    img.onerror = function() {\n      alert(\"\u0639\u0630\u0631\u0627\u064b\u060c \u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0635\u0648\u0631\u0629.\");\n      URL.revokeObjectURL(url);\n    };\n\n  } catch (err) {\n    console.error(err);\n    alert(\"\u062d\u062f\u062b \u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0644\u0627\u062d\u0642\u0627\u064b.\");\n  }\n});\n/* ============ \u0628\u0631\u0645\u062c\u0629 \u0646\u0627\u0641\u0630\u0629 \u0639\u0631\u0636 \u0627\u0644\u0635\u0648\u0631 (Lightbox) ============ */\n(function(){\n  const modal = document.getElementById('imageModal');\n  const modalImg = document.getElementById('modalImage');\n  const downloadLink = document.getElementById('downloadOriginal');\n  const closeBtn = document.getElementById('closeModal');\n  \n  // \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0644\u0623\u064a \u0635\u0648\u0631\u0629 \u062a\u0645\u062a\u0644\u0643 \u0627\u0644\u0643\u0644\u0627\u0633 trigger-modal\n  document.querySelectorAll('.trigger-modal').forEach(img => {\n    img.addEventListener('click', function() {\n      const highResSource = this.getAttribute('data-highres');\n      \n      modalImg.src = highResSource;\n      downloadLink.href = highResSource;\n      \n      modal.classList.add('active');\n      document.body.style.overflow = 'hidden'; // \u0625\u0