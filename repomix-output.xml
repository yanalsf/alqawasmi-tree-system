// apps/admin/components/LineageCertificateModal.tsx
"use client";

import type { FamilyNode } from "@/lib/constants";

interface LineageCertificateModalProps {
  isOpen: boolean;
  /** Root-to-target ancestor chain, e.g. [branchRoot, ..., grandparent, person]. */
  ancestorPath: FamilyNode[] | null;
  /** Total number of real people in the whole tree, shown in the footer. */
  totalCount: number;
  onClose: () => void;
}

export default function LineageCertificateModal({
  isOpen,
  ancestorPath,
  totalCount,
  onClose,
}: LineageCertificateModalProps) {
  if (!isOpen || !ancestorPath || ancestorPath.length === 0) return null;

  const person = ancestorPath[ancestorPath.length - 1];
  // Legacy prints the chain from the focused person up to the root (reversed).
  const reversedPath = [...ancestorPath].reverse();

  const dateAr = new Date().toLocaleDateString("ar-JO", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
  });

  return (
    <>
      {/* On-screen preview + controls — hidden entirely when actually printing */}
      <div
        onClick={onClose}
        className="no-print fixed inset-0 z-[1000] flex items-center justify-center bg-black/60 font-cairo"
      >
        <div
          onClick={(e) => e.stopPropagation()}
          className="max-h-[80vh] w-[420px] max-w-[90vw] overflow-y-auto rounded-2xl bg-white p-6 text-center shadow-[0_10px_25px_rgba(0,0,0,0.3)]"
        >
          <h3 className="mb-2 mt-0 font-extrabold text-gold-deep">
            وثيقة إثبات نسب: {person.name}
          </h3>
          <p className="mb-4 text-xs text-ink-soft">
            سيتم طباعة سلسلة النسب التالية من "{reversedPath[0].name}" حتى الجذر "
            {reversedPath[reversedPath.length - 1].name}".
          </p>

          <ol className="mb-5 flex flex-col items-center gap-1 text-sm text-ink">
            {reversedPath.map((node, i) => (
              <li key={node.id}>
                {i > 0 && <span className="text-ink-soft"> بن </span>}
                <span className={i === 0 ? "font-bold text-gold-deep" : ""}>{node.name}</span>
              </li>
            ))}
          </ol>

          <div className="flex justify-center gap-2.5">
            <button
              type="button"
              onClick={() => window.print()}
              className="flex-1 rounded-lg bg-green-2 px-4 py-2.5 font-bold text-white"
            >
              🖨️ طباعة / حفظ PDF
            </button>
            <button
              type="button"
              onClick={onClose}
              className="flex-1 rounded-lg bg-gray-400 px-4 py-2.5 font-bold text-white"
            >
              إغلاق
            </button>
          </div>
        </div>
      </div>

      {/* Print-only content — invisible on screen, shown only by @media print in globals.css */}
      <div className="lineage-print-area">
        <h2 className="lineage-print-title">
          شجرة عائلة القواسمي
          <br />
          <span style={{ fontSize: 16, color: "#7c6c53", fontFamily: "Cairo, sans-serif" }}>
            وثيقة إثبات تسلسل نسب: {person.name}
          </span>
        </h2>

        <div className="lineage-stem">
          {reversedPath.map((node, i) => (
            <span key={node.id} style={{ display: "contents" }}>
              <div
                className={`lineage-leaf ${i === 0 ? "lineage-focus" : ""} ${
                  i === reversedPath.length - 1 ? "lineage-root" : ""
                }`}
              >
                {node.name}
              </div>
              {i < reversedPath.length - 1 && <div className="lineage-ben-label">بـن</div>}
            </span>
          ))}
        </div>

        <div className="lineage-print-footer">
          عدد الأفراد داخل الشجرة: <span style={{ fontWeight: "bold", color: "#8a5f2e" }}>{totalCount} فرد</span>
          <br />
          تاريخ الإصدار: {dateAr}
        </div>
      </div>
    </>
  );
}
