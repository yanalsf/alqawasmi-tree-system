u0646\u0638\u0627\u0645 \u0627\u0644\u0623\u0641\u062e\u0627\u0630 \u0627\u0644\u0630\u0643\u064a \u0648\u062a\u0641\u0643\u064a\u0643 \u0627\u0644\u062c\u0630\u0631 \u0627\u0644\u0645\u062e\u0641\u064a --- */\nlet allBranches = {};\n\nObject.keys(branchNames).forEach(key => {\n  allBranches[key] = { id: null, name: branchNames[key], children: [] };\n});\n\nif (typeof treeData !== 'undefined' && treeData) {\n  if (treeData.name === 'System_Root' && treeData.children) {\n    treeData.children.forEach(branch => {\n      if (branch.name.includes('\u062f\u0627\u0648\u0648\u062f')) allBranches['dawoud'] = branch;\n      else if (branch.name.includes('\u0646\u0648\u0627\u0631\u0647')) allBranches['abu_nawara'] = branch;\n      else if (branch.name.includes('\u0627\u0644\u0635\u0648\u0635')) allBranches['al_sous'] = branch;\n      else if (branch.name.includes('\u0639\u0628\u062f\u0627\u0644\u0644\u0647')) allBranches['abdullah'] = branch;\n      else if (branch.name.includes('\u0627\u0644\u062c\u062f\u0639')) allBranches['al_jadaa'] = branch;\n      else if (branch.name.includes('\u0645\u062d\u0645\u062f \u0633\u0644\u064a\u0645\u0627\u0646')) allBranches['mohammed_sulaiman'] = branch;\n      else if (branch.name.includes('\u064a\u0648\u0646\u0633')) allBranches['younes'] = branch;\n      else if (branch.name.includes('\u0628\u062f\u0648\u064a')) allBranches['al_badawi'] = branch;\n      else if (branch.name.includes('\u0645\u062d\u0645\u062f \u0639\u0644\u064a')) allBranches['mohammed_ali'] = branch;\n      else if (branch.name.includes('\u0628\u064a\u0636')) allBranches['abu_baid'] = branch;\n      else if (branch.name.includes('\u0627\u0644\u062e\u0636\u064a\u0631')) allBranches['al_khudair'] = branch;\n      else if (branch.name.includes('\u0627\u0644\u062d\u0642')) allBranches['abdulhaq'] = branch;\n    });\n  } else if (treeData.name) {\n    allBranches['dawoud'] = treeData;\n  }\n}\n\nlet idCounter = 0;\nfunction assignIds(node, depth){\n  if (!node) return;\n  node._id = 'n' + (idCounter++);\n  node._depth = depth;\n  if(node.children && Array.isArray(node.children)) {\n    node.children.forEach(c => assignIds(c, depth + 1));\n  }\n}\n\nObject.values(allBranches).forEach(branchRoot => assignIds(branchRoot, 0));\n\nlet currentBranchKey = 'dawoud'; \nlet activeTree = allBranches[currentBranchKey] || Object.values(allBranches)[0];\nlet currentPath = [activeTree];\n\n/* ========================================================================== */\n/* ======================== 2. \u062f\u0648\u0627\u0644 \u0627\u0644\u0634\u062c\u0631\u0629 \u0648\u0627\u0644\u062a\u0646\u0642\u0644 ========================== */\n/* ========================================================================== */\n\nfunction countDescendants(node){\n  if(!node.children) return 0;\n  let n = node.children.length;\n  node.children.forEach(c => n += countDescendants(c));\n  return n;\n}\nfunction countAll(node){\n  let n = 1;\n  if(node.children) node.children.forEach(c => n += countAll(c));\n  return n;\n}\nfunction maxDepth(node){\n  if(!node.children || !node.children.length) return 1;\n  return 1 + Math.max(...node.children.map(maxDepth));\n}\nfunction getAncestors(node, id, path){\n  path.push(node);\n  if(node._id === id) return path;\n  if(node.children){\n    for(const c of node.children){\n      const result = getAncestors(c, id, path.slice());\n      if(result) return result;\n    }\n  }\n  return null;\n}\n\nfunction currentFocus(){ return currentPath[currentPath.length - 1]; }\nfunction navigateToPath(path){ currentPath = path; renderPage(); window.scrollTo({ top: 0, behavior: 'smooth' }); }\nfunction navigateIntoChild(child){ navigateToPath(currentPath.concat(child)); }\nfunction goBack(){ if(currentPath.length > 1) navigateToPath(currentPath.slice(0, -1)); }\nfunction goHome(){ navigateToPath([activeTree]); }\nfunction navigateToNodeId(id){ const ancestors = getAncestors(activeTree, id, []); if(ancestors) navigateToPath(ancestors); }\n\nfunction renderBreadcrumb(){\n  const bc = document.getElementById('breadcrumb');\n  bc.innerHTML = '';\n  currentPath.forEach((node, i) => {\n    if(i > 0){\n      const sep = document.createElement('span'); sep.className = 'sep'; sep.textContent = '\u2039'; bc.appendChild(sep);\n    }\n    const btn = document.createElement('button');\n    const isCurrent = i === currentPath.length - 1;\n    btn.className = isCurrent ? 'current' : '';\n    btn.textContent = node.name;\n    if(!isCurrent) btn.addEventListener('click', () => navigateToPath(currentPath.slice(0, i + 1)));\n    bc.appendChild(btn);\n  });\n  bc.scrollLeft = bc.scrollWidth;\n}\n\n/* ========================================================================== */\n/* ===================== 3. \u0628\u0646\u0627\u0621 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 (\u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a) ========================= */\n/* ========================================================================== */\n\nfunction renderPage(){\n  const focus = currentFocus();\n  const isRoot = currentPath.length === 1;\n  const kidsCount = focus.children ? focus.children.length : 0;\n\n  document.getElementById('backBtn').disabled = isRoot;\n  renderBreadcrumb();\n\n\n  const page = document.getElementById('pageContent');\n  page.innerHTML = '';\n  void page.offsetWidth;\n\n  const focusCard = document.createElement('div');\n  focusCard.className = 'focus-card reveal ' + (kidsCount ? 'has-children' : 'no-children');\n  focusCard.innerHTML = LEAF_SVG;\n\n  const nameEl = document.createElement('div');\n  nameEl.className = 'name';\n  nameEl.textContent = focus.name.replace('\u0641\u062e\u0630 ', '').trim();\n  focusCard.appendChild(nameEl);\n\n  if (focus.birth_date || focus.death_date) {\n    const focusDatesDiv = document.createElement('div');\n    focusDatesDiv.style.cssText = 'font-size: 13.5px; color: #fff9ee; margin-top: 4px; line-height: 1.4; opacity: 0.95;';\n    let fDateStr = '', fAgeStr = '';\n    if (focus.birth_date && focus.death_date) {\n      fDateStr = `${getYearOnly(focus.birth_date)} - ${getYearOnly(focus.death_date)}`;\n      fAgeStr = `\u062a\u0648\u0641\u064a \u0639\u0646 ${calculateExactAge(focus.birth_date, focus.death_date)} \u0639\u0627\u0645\u0627\u064b`;\n    } else if (focus.birth_date) {\n      fDateStr = `\u0648\u0644\u062f \u0641\u064a ${getYearOnly(focus.birth_date)}`;\n      fAgeStr = `\u0627\u0644\u0639\u0645\u0631: ${calculateExactAge(focus.birth_date, null)}`;\n    } else if (focus.death_date) {\n      fDateStr = `\u062a\u0648\u0641\u064a \u0639\u0627\u0645 ${getYearOnly(focus.death_date)}`;\n    }\n    focusDatesDiv.innerHTML = `<span>${fDateStr}</span><br><span style=\"font-size: 12px;\">${fAgeStr}</span>`;\n    focusCard.appendChild(focusDatesDiv);\n  }\n\n  if(!isRoot){\n    const fatherName = currentPath[currentPath.length - 2].name;\n    const fatherTag = document.createElement('div');\n    fatherTag.className = 'father-tag';\n    fatherTag.textContent = `\u0627\u0628\u0646 ${fatherName}`;\n    focusCard.appendChild(fatherTag);\n  }\n\n  const meta = document.createElement('div');\n  meta.className = 'meta';\n  const descCount = countDescendants(focus);\n  meta.textContent = kidsCount ? `${kidsCount} \u0645\u0646 \u0627\u0644\u0623\u0628\u0646\u0627\u0621 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u064a\u0646 \u2014 ${descCount} \u0641\u0631\u062f\u064b\u0627 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0641\u0631\u0639` : '\u0644\u0627 \u064a\u0648\u062c\u062f \u0623\u0628\u0646\u0627\u0621 \u0645\u0633\u062c\u0644\u0648\u0646';\n  focusCard.appendChild(meta);\n\n  const focusActions = document.createElement('div');\n  focusActions.className = 'focus-actions';\n  const drawTreeBtn = document.createElement('button');\n  drawTreeBtn.className = 'btn ghost small';\n  drawTreeBtn.innerHTML = '\ud83c\udf3f \u0639\u0631\u0636 \u0627\u0644\u0634\u062c\u0631\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629';\n  drawTreeBtn.addEventListener('click', () => { openVisualTree(focus); });\n  focusActions.appendChild(drawTreeBtn);\n  focusCard.appendChild(focusActions);\n\n  page.appendChild(focusCard);\n\n  if(kidsCount){\n    const sectionTitle = document.createElement('div');\n    sectionTitle.className = 'section-title';\n    sectionTitle.innerHTML = `\u0627\u0644\u0623\u0628\u0646\u0627\u0621 <span class=\"badge\">${kidsCount}</span>`;\n    page.appendChild(sectionTitle);\n\n    const grid = document.createElement('div');\n    grid.className = 'children-grid';\n    focus.children.forEach((child, idx) => {\n      const childKids = child.children ? child.children.length : 0;\n      const card = document.createElement('div');\n      card.className = 'child-card reveal ' + (childKids ? 'has-children' : 'no-children');\n      card.innerHTML = LEAF_SVG;\n\n      const cName = document.createElement('div');\n      cName.className = 'name';\n      cName.textContent = child.name;\n      card.appendChild(cName);\n\n      if (child.birth_date || child.death_date) {\n        const datesDiv = document.createElement('div');\n        datesDiv.style.cssText = 'font-size: 11.5px; color: #f6fbef; margin-top: 4px; line-height: 1.4; opacity: 0.9; text-align: center;';\n        let dateStr = '', ageStr = '';\n        if (child.birth_date && child.death_date) {\n          dateStr = `${getYearOnly(child.birth_date)} - ${getYearOnly(child.death_date)}`;\n          ageStr = `\u062a\u0648\u0641\u064a \u0639\u0646 ${calculateExactAge(child.birth_date, child.death_date)} \u0639\u0627\u0645\u0627\u064b`;\n        } else if (child.birth_date) {\n          dateStr = `\u0648\u0644\u062f \u0641\u064a ${getYearOnly(child.birth_date)}`;\n          ageStr = `\u0627\u0644\u0639\u0645\u0631: ${calculateExactAge(child.birth_date, null)}`;\n        } else if (child.death_date) {\n          dateStr = `\u062a\u0648\u0641\u064a \u0639\u0627\u0645 ${getYearOnly(child.death_date)}`;\n        }\n        datesDiv.innerHTML = `<span style=\"font-weight:bold;\">${dateStr}</span><br><span style=\"font-size: 10.5px;\">${ageStr}</span>`;\n        card.appendChild(datesDiv);\n      }\n\n      const fatherTag = document.createElement('div');\n      fatherTag.className = 'father-tag';\n      fatherTag.textContent = `\u0627\u0628\u0646 ${focus.name}`;\n      card.appendChild(fatherTag);\n\n      const sub = document.createElement('div');\n      sub.className = 'sub';\n      sub.textContent = childKids ? `${childKids} \u0623\u0628\u0646\u0627\u0621` : '\u0628\u062f\u0648\u0646 \u0623\u0628\u0646\u0627\u0621';\n      card.appendChild(sub);\n\n      if(childKids){\n        const badge = document.createElement('span');\n        badge.className = 'count-badge';\n        const total = countDescendants(child);\n        badge.textContent = total > 99 ? '99+' : total;\n        card.appendChild(badge);\n      }\n\n      card.addEventListener('click', () => navigateIntoChild(child));\n      grid.appendChild(card);\n    });\n    page.appendChild(grid);\n  } else {\n    const empty = document.createElement('div');\n    empty.className = 'empty-state';\n    empty.textContent = '\u0644\u0627 \u064a\u0648\u062c\u062f \u0623\u0628\u0646\u0627\u0621 \u0645\u0633\u062c\u0644\u064a\u0646 \u0644\u0647\u0630\u0627 \u0627\u0644\u0627\u0633\u0645 \u062d\u062a\u0649 \u0627\u0644\u0622\u0646.';\n    page.appendChild(empty);\n  }\n\n  updateStats();\n  requestAnimationFrame(() => observeReveal(page));\n}\n\nfunction updateStats(){\n  document.getElementById('statsBar').textContent = `\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0641\u064a \u0627\u0644\u0634\u062c\u0631\u0629: ${countAll(activeTree)} \u2014 \u0639\u062f\u062f \u0627\u0644\u0623\u062c\u064a\u0627\u0644: ${maxDepth(activeTree)}`;\n}\n\ndocument.getElementById('backBtn').addEventListener('click', goBack);\ndocument.getElementById('homeBtn').addEventListener('click', goHome);\n\n/* ========================================================================== */\n/* =================== 4. \u0627\u0644\u0641\u0647\u0631\u0633 (Sidebar) \u0648\u0627\u0644\u0642\u0648\u0627\u0626\u0645 ========================= */\n/* ========================================================================== */\n\nconst sidebarList = document.getElementById('sidebarList');\nlet flatIndex = [];\n\nfunction buildFlatIndex(){\n  flatIndex = [];\n  if (!activeTree) return;\n  (function walk(node, fatherName){\n    flatIndex.push({ id: node._id, name: node.name, depth: node._depth, father: fatherName });\n    if(node.children) node.children.forEach(c => walk(c, node.name));\n  })(activeTree, null);\n}\n\nfunction rebuildSidebar(){\n  buildFlatIndex();\n  sidebarList.innerHTML = '';\n  flatIndex.forEach(item => {\n    const li = document.createElement('li');\n    const btn = document.createElement('button');\n    btn.dataset.name = item.name;\n    const row = document.createElement('div');\n    row.style.display = 'flex'; row.style.alignItems = 'center'; row.style.gap = '6px';\n    const dot = document.createElement('span'); dot.className = 'depth-dot'; dot.style.opacity = Math.max(0.25, 1 - item.depth * 0.18);\n    row.appendChild(dot);\n    const label = document.createElement('span'); label.textContent = item.name; row.appendChild(label);\n    btn.appendChild(row);\n    if(item.father){\n      const fatherTag = document.createElement('span'); fatherTag.className = 'father-tag'; fatherTag.textContent = `\u0627\u0628\u0646 ${item.father}`;\n      btn.appendChild(fatherTag);\n    }\n    btn.style.paddingRight = (10 + item.depth * 10) + 'px';\n    btn.addEventListener('click', () => { navigateToNodeId(item.id); if(window.innerWidth <= 900) closeSidebar(); });\n    li.appendChild(btn);\n    sidebarList.appendChild(li);\n  });\n  document.getElementById('sidebarCount').textContent = `${flatIndex.length} \u0627\u0633\u0645\u064b\u0627`;\n}\n\ndocument.getElementById('sidebarSearch').addEventListener('input', (e) => {\n  const q = e.target.value.trim();\n  const items = sidebarList.querySelectorAll('li');\n  let visible = 0;\n  items.forEach(li => {\n    const btn = li.querySelector('button');\n    const match = !q || btn.dataset.name.includes(q);\n    li.classList.toggle('hidden', !match);\n    if(match) visible++;\n  });\n  document.getElementById('sidebarCount').textContent = q ? `${visible} \u0646\u062a\u064a\u062c\u0629` : `${flatIndex.length} \u0627\u0633\u0645\u064b\u0627`;\n});\n\nconst sidebar = document.getElementById('sidebar');\nconst overlay = document.getElementById('sidebarOverlay');\nconst sidebarToggleBtn = document.getElementById('sidebarToggle'); \nfunction openSidebar(){ sidebar.classList.add('open'); overlay.classList.add('open'); sidebarToggleBtn.style.display = 'none'; }\nfunction closeSidebar(){ sidebar.classList.remove('open'); overlay.classList.remove('open'); sidebarToggleBtn.style.display = 'block'; }\ndocument.getElementById('sidebarToggle').addEventListener('click', openSidebar);\ndocument.getElementById('sidebarClose').addEventListener('click', closeSidebar);\noverlay.addEventListener('click', closeSidebar);\n\n/* ========================================================================== */\n/* ====================== 5. \u0627\u0644\u062a\u0646\u0642\u0644 \u0628\u064a\u0646 \u0627\u0644\u0634\u0627\u0634\u0627\u062a \u0648\u0627\u0644\u0623\u0641\u062e\u0627\u0630 ==================== */\n/* ========================================================================== */\n\nconst screens = { branchSelect: document.getElementById('branchSelect'), branchPlaceholder: document.getElementById('branchPlaceholder'), app: document.getElementById('app') };\n\nfunction showScreen(key){\n  Object.keys(screens).forEach(k => { if(screens[k]) screens[k].classList.remove('visible', 'app-visible'); });\n  if(key === 'app'){\n    screens.app.style.display = 'block';\n    requestAnimationFrame(() => screens.app.classList.add('app-visible'));\n  } else {\n    screens.app.style.display = 'none';\n    screens[key].classList.add('visible');\n  }\n  window.scrollTo({ top: 0, behavior: 'smooth' });\n}\n\nfunction selectBranch(key) {\n  const selectedBranchName = branchNames[key] || '\u0634\u062c\u0631\u0629 \u0627\u0644\u0639\u0627\u0626\u0644\u0629';\n  \n  if ((allBranches[key] && allBranches[key].children && allBranches[key].children.length > 0) || key === 'dawoud') {\n    document.getElementById('headerLeftBtn').textContent = selectedBranchName;\n    document.getElementById('vtTitle').textContent = `\u0634\u062c\u0631\u0629 \u0646\u0633\u0628: ${selectedBranchName}`;\n   currentBranchKey = key;\n  activeTree = allBranches[key];\n  currentPath = [activeTree];\n  \n  const theme = branchThemeColors[key] || branchThemeColors['dawoud'];\n  document.documentElement.style.setProperty('--theme-no-kids', theme.noKids);\n  document.documentElement.style.setProperty('--theme-has-kids', theme.hasKids);\n  document.documentElement.style.setProperty('--theme-no-kids-dark', theme.noKidsDark);\n  document.documentElement.style.setProperty('--theme-has-kids-dark', theme.hasKidsDark);\n    buildFlatIndex();\n    rebuildSidebar();\n    renderPage();\n    setTimeout(() => showScreen('app'), 250);\n  } else {\n    document.getElementById('branchPlaceholderTitle').textContent = selectedBranchName;\n    showScreen('branchPlaceholder');\n  }\n  if (typeof closeHeaderDropdown === 'function') closeHeaderDropdown();\n}\n\ndocument.querySelectorAll('.branch-card').forEach(card => {\n  card.onclick = () => { selectBranch(card.getAttribute('data-branch')); };\n});\n\n/* ========================================================================== */\n/* ============ 5.5 \u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u0623\u0641\u062e\u0627\u0630 \u0627\u0644\u0643\u0627\u0645\u0644 (Sequence / Lineage Modal) ========== */\n/* ========================================================================== */\n/*\n  \u0647\u0630\u0627 \u0627\u0644\u0642\u0633\u0645 \u064a\u0628\u0646\u064a \u0645\u062e\u0637\u0637\u0627\u064b \u0628\u0635\u0631\u064a\u0627\u064b \u064a\u0648\u0636\u062d \u062a\u0633\u0644\u0633\u0644 \u0646\u0633\u0628 \u0627\u0644\u0639\u0627\u0626\u0644\u0629 \u0628\u062f\u0621\u0627\u064b \u0645\u0646 \u0627\u0644\u062c\u062f \u0627\u0644\u0623\u0648\u0644\n  \u0648\u0635\u0648\u0644\u0627\u064b \u0625\u0644\u0649 \u0643\u0644 \"\u0641\u062e\u0630\" \u0645\u0646 \u0627\u0644\u0623\u0641\u062e\u0627\u0630 \u0627\u0644\u0627\u062b\u0646\u064a \u0639\u0634\u0631. \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0648\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u0645\u0644\u0648\u0651\u0646\u0629 \u0641\u064a\n  \u0646\u0647\u0627\u064a\u0629 \u0643\u0644 \u062a\u0633\u0644\u0633\u0644 \u0645\u0623\u062e\u0648\u0630\u0629 \u0645\u0628\u0627\u0634\u0631\u0629 \u0645\u0646 \u0628\u0637\u0627\u0642\u0627\u062a \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0641\u062e\u0630 (data-branch/.branch-name)\n  \u0648\u0645\u0646 \u0646\u0641\u0633 \u0646\u0638\u0627\u0645 \u0627\u0644\u0623\u0644\u0648\u0627\u0646 (branchThemeColors) \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0628\u0627\u0642\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0628\u062d\u064a\u062b \u062a\u0628\u0642\u0649\n  \u0645\u062a\u0637\u0627\u0628\u0642\u0629 \u062a\u0645\u0627\u0645\u0627\u064b \u0645\u0639 \u0623\u064a \u062a\u0639\u062f\u064a\u0644 \u0645\u0633\u062a\u0642\u0628\u0644\u064a \u0639\u0644\u0649 \u062a\u0644\u0643 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u2014 \u0648\u0644\u0627 \u062a\u064f\u0643\u062a\u0628 \u064a\u062f\u0648\u064a\u0627\u064b \u0647\u0646\u0627.\n  \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0623\u064a \u0627\u0633\u0645 \u0645\u0644\u0648\u0651\u0646 \u064a\u0633\u062a\u062f\u0639\u064a \u0646\u0641\u0633 \u0627\u0644\u062f\u0627\u0644\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 selectBranch(key) \u0644\u0644\u062a\u0646\u0642\u0644.\n*/\n\nfunction seqGetBranchLabel(key){\n  const nameEl = document.querySelector(`.branch-card[data-branch=\"${key}\"] .branch-name`);\n  return nameEl ? nameEl.textContent.trim() : (branchNames[key] || key);\n}\nfunction seqGetBranchColor(key){\n  const theme = branchThemeColors[key];\n  return theme ? theme.hasKids : '#8a5f2e';\n}\nfunction seqLeaf(key){\n  return { isLeaf:true, branchKey:key, name: seqGetBranchLabel(key), color: seqGetBranchColor(key) };\n}\nfunction seqNode(name, children){\n  return { isLeaf:false, name, children: children || [] };\n}\n\n// \u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 (\u0627\u0644\u062c\u062f \u0627\u0644\u0645\u0634\u062a\u0631\u0643 \u2190 \u0627\u0644\u0623\u0628\u0646\u0627\u0621 \u2190 \u0627\u0644\u0623\u0641\u062e\u0627\u0630 \u0627\u0644\u0627\u062b\u0646\u0627 \u0639\u0634\u0631)\nfunction buildFamilySequenceData(){\n  return seqNode('\u0642\u0627\u0633\u0645', [\n    seqNode('\u0645\u062d\u0645\u0648\u062f', [\n      seqNode('\u064a\u0648\u0633\u0641', [\n        seqNode('\u062d\u062c\u0627\u0632\u064a', [\n          // \u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0627\u0644\u0645\u0633\u062a\u0645\u0631 \u0646\u062d\u0648 \u0627\u0644\u0623\u0641\u062e\u0627\u0630 \u0627\u0644\u062b\u0644\u0627\u062b\u0629 \u0627\u0644\u0643\u0628\u0631\u0649\n          seqNode('\u0628\u062f\u0631', [\n            seqNode('\u0642\u0627\u0633\u0645', [\n              seqNode('\u0645\u062d\u0645\u0648\u062f', [\n                seqNode('\u0639\u064a\u0633\u0649', [ seqNode('\u0633\u0644\u064a\u0645\u0627\u0646', [ seqLeaf('abu_baid') ]) ]),\n                seqNode('\u0645\u062d\u0645\u062f', [ seqNode('\u0623\u062d\u0645\u062f \u062e\u0636\u064a\u0631', [ seqLeaf('al_khudair'), seqLeaf('mohammed_ali') ]) ])\n              ]),\n              seqNode('\u0645\u062d\u0645\u062f', [\n                seqNode('\u0639\u0628\u062f\u0627\u0644\u0645\u062d\u0633\u0646', [ seqNode('\u064a\u0648\u0633\u0641', [ seqLeaf('al_badawi') ]) ]),\n                seqNode('\u0645\u062d\u0645\u062f', [ seqNode('\u0639\u0628\u062f\u0627\u0644\u0645\u062d\u0633\u0646', [ seqLeaf('younes') ]) ])\n              ]),\n              seqNode('\u0639\u0628\u062f\u0627\u0644\u0644\u0647', [\n                seqNode('\u0642\u0627\u0633\u0645', [ seqLeaf('abu_nawara'), seqLeaf('al_sous') ]),\n                seqNode('\u0635\u0627\u0644\u062d', [\n                  seqNode('\u0633\u0644\u0645\u0627\u0646', [ seqLeaf('abdullah') ]),\n                  seqNode('\u0633\u0644\u064a\u0645\u0627\u0646', [ seqLeaf('al_jadaa'), seqLeaf('mohammed_sulaiman'), seqLeaf('dawoud') ])\n                ])\n              ])\n            ])\n          ]),\n          // \u0641\u0631\u0639 \u062c\u0627\u0646\u0628\u064a \u0639\u0646 \u0646\u0641\u0633 \u062d\u062c\u0627\u0632\u064a (\u0623\u0639\u0644\u0627\u0647) \u064a\u0646\u062a\u0647\u064a \u0628\u0641\u062e\u0630 \u0639\u0628\u062f \u0627\u0644\u062d\u0642\n          seqNode('\u064a\u0648\u0633\u0641', [ seqNode('\u062d\u062c\u0627\u0632\u064a', [ seqNode('\u0639\u0628\u062f \u0627\u0644\u0645\u0639\u0637\u064a', [ seqLeaf('abdulhaq') ]) ]) ])\n        ])\n      ])\n    ])\n  ]);\n}\n\nfunction seqBuildLeafButton(node, listStyle){\n  const btn = document.createElement('button');\n  btn.type = 'button';\n  btn.className = listStyle ? 'seq-leaf-list' : 'seq-leaf';\n  btn.style.background = node.color;\n  btn.textContent = node.name;\n  btn.title = `\u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 ${node.name}`;\n  btn.addEventListener('click', () => {\n    closeSequenceModal();\n    selectBranch(node.branchKey);\n  });\n  return btn;\n}\n\n// \u0628\u0646\u0627\u0621 \u0639\u0631\u0636 \"\u0627\u0644\u0645\u062e\u0637\u0637\" (Org-chart) \u2014 \u0627\u0644\u0623\u0646\u0633\u0628 \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0627\u062a \u0627\u0644\u0643\u0628\u064a\u0631\u0629\nfunction seqBuildDiagramLi(node){\n  const li = document.createElement('li');\n  if(node.isLeaf){\n    li.appendChild(seqBuildLeafButton(node, false));\n    return li;\n  }\n  const label = document.createElement('div');\n  label.className = 'seq-node';\n  label.textContent = node.name;\n  li.appendChild(label);\n  if(node.children && node.children.length){\n    const ul = document.createElement('ul');\n    node.children.forEach(child => ul.appendChild(seqBuildDiagramLi(child)));\n    li.appendChild(ul);\n  }\n  return li;\n}\n\n// \u0628\u0646\u0627\u0621 \u0639\u0631\u0636 \"\u0627\u0644\u0642\u0627\u0626\u0645\u0629\" (indented list) \u2014 \u0627\u0644\u0623\u0646\u0633\u0628 \u0639\u0644\u0649 \u0627\u0644\u0647\u0648\u0627\u062a\u0641\u060c \u0628\u0644\u0627 \u062a\u0645\u0631\u064a\u0631 \u0623\u0641\u0642\u064a\nfunction seqBuildListNode(node){\n  const wrap = document.createElement('div');\n  if(node.isLeaf){\n    wrap.appendChild(seqBuildLeafButton(node, true));\n    return wrap;\n  }\n  const row = document.createElement('div');\n  row.className = 'seq-list-row';\n  const dot = document.createElement('span'); dot.className = 'seq-list-dot';\n  const label = document.createElement('span'); label.textContent = node.name;\n  row.appendChild(dot); row.appendChild(label);\n  wrap.appendChild(row);\n  if(node.children && node.children.length){\n    const childWrap = document.createElement('div');\n    childWrap.className = 'seq-list-children';\n    node.children.forEach(child => childWrap.appendChild(seqBuildListNode(child)));\n    wrap.appendChild(childWrap);\n  }\n  return wrap;\n}\n\nconst sequenceModal = document.getElementById('sequenceModal');\nconst sequenceModalBody = document.getElementById('sequenceModalBody');\nconst seqViewDiagramBtn = document.getElementById('seqViewDiagram');\nconst seqViewListBtn = document.getElementById('seqViewList');\nlet sequenceViewMode = window.innerWidth < 720 ? 'list' : 'diagram';\nlet familySequenceData = null; // \u064a\u064f\u0628\u0646\u0649 \u0639\u0646\u062f \u0623\u0648\u0644 \u0641\u062a\u062d \u0644\u0644\u0646\u0627\u0641\u0630\u0629 (\u0628\u0639\u062f \u0623\u0646 \u062a\u0643\u0648\u0646 \u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0623\u0641\u062e\u0627\u0630 \u062c\u0627\u0647\u0632\u0629 \u0641\u064a \u0627\u0644\u0635\u0641\u062d\u0629)\n\nfunction seqSetActiveToggle(){\n  seqViewDiagramBtn.classList.toggle('active', sequenceViewMode === 'diagram');\n  seqViewDiagramBtn.setAttribute('aria-selected', sequenceViewMode === 'diagram');\n  seqViewListBtn.classList.toggle('active', sequenceViewMode === 'list');\n  seqViewListBtn.setAttribute('aria-selected', sequenceViewMode === 'list');\n}\n\nlet orgTreeScale = 1;\n\nfunction renderSequence(){\n  if(!familySequenceData) familySequenceData = buildFamilySequenceData();\n  sequenceModalBody.innerHTML = '';\n  if(sequenceViewMode === 'diagram'){\n    const outerWrap = document.createElement('div');\n    outerWrap.id = 'orgTreeFitOuter';\n    const fitWrap = document.createElement('div');\n    fitWrap.id = 'orgTreeFit';\n    const inner = document.createElement('div');\n    inner.id = 'orgTreeInner';\n    const ul = document.createElement('ul');\n    ul.className = 'org-tree';\n    ul.appendChild(seqBuildDiagramLi(familySequenceData));\n    inner.appendChild(ul);\n    fitWrap.appendChild(inner);\n    outerWrap.appendChild(fitWrap);\n    sequenceModalBody.appendChild(outerWrap);\n\n    // \u0646\u0635\u063a\u0651\u0631 \u0627\u0644\u0645\u062e\u0637\u0637 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0643\u064a \u064a\u0638\u0647\u0631 \u0627\u0644\u062a\u0633\u0644\u0633\u0644 \u0643\u0627\u0645\u0644\u0627\u064b \u0648\u0645\u064f\u0645\u0631\u0643\u0632\u0627\u064b \u0639\u0644\u0649 \u0642\u0627\u0633\u0645 (\u0627\u0644\u062c\u0630\u0631) \u0641\u0648\u0631 \u0627\u0644\u0641\u062a\u062d\u060c \u062f\u0648\u0646 \u0623\u064a \u062a\u062f\u062e\u0644 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\n    requestAnimationFrame(fitOrgTreeToScreen);\n  } else {\n    const outerWrap = document.createElement('div');\n    outerWrap.id = 'seqListFitOuter';\n    const listWrap = document.createElement('div');\n    listWrap.id = 'seqListFit';\n    listWrap.appendChild(seqBuildListNode(familySequenceData));\n    outerWrap.appendChild(listWrap);\n    sequenceModalBody.appendChild(outerWrap);\n  }\n  seqSetActiveToggle();\n}\n\nfunction applyOrgTreeScale(scale, naturalWidth, naturalHeight){\n  const wrap = document.getElementById('orgTreeFit');\n  const inner = document.getElementById('orgTreeInner');\n  if(!wrap || !inner) return;\n  orgTreeScale = scale;\n  // \u0646\u064f\u062b\u0628\u0651\u062a \u062d\u062c\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0639\u0644\u0649 \u0642\u064a\u0627\u0633\u0647 \u0627\u0644\u0637\u0628\u064a\u0639\u064a \u0627\u0644\u0643\u0627\u0645\u0644 \u062f\u0627\u0626\u0645\u0627\u064b \u0643\u064a \u0644\u0627 \u064a\u0646\u0643\u0645\u0634 \u0645\u062d\u062a\u0648\u0627\u0647 \u0623\u0648 \u064a\u0646\u0632\u0627\u062d\u060c\n  // \u062b\u0645 \u0646\u0635\u063a\u0651\u0631\u0647 \u0628\u0635\u0631\u064a\u0627\u064b \u0641\u0642\u0637 \u0639\u0628\u0631 transform\u060c \u0648\u0646\u062c\u0639\u0644 \u0627\u0644\u063a\u0644\u0627\u0641 \u0627\u0644\u062e\u0627\u0631\u062c\u064a \u0628\u062d\u062c\u0645 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629 \u0643\u064a \u0644\u0627 \u062a\u0641\u064a\u0636 \u0627\u0644\u0634\u062c\u0631\u0629 \u064a\u0645\u064a\u0646\u0627\u064b \u0623\u0648 \u064a\u0633\u0627\u0631\u0627\u064b\n  inner.style.width = naturalWidth + 'px';\n  inner.style.height = naturalHeight + 'px';\n  inner.style.transform = `scale(${scale})`;\n  wrap.style.width = (naturalWidth * scale) + 'px';\n  wrap.style.height = (naturalHeight * scale) + 'px';\n  wrap.style.overflow = 'hidden';\n}\n\n// \u064a\u0635\u063a\u0651\u0631 \u0627\u0644\u0645\u062e\u0637\u0637 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0628\u062d\u064a\u062b \u062a\u0638\u0647\u0631 \u0627\u0644\u0633\u0644\u0633\u0644\u0629 \u0643\u0627\u0645\u0644\u0629 \u0645\u0646 \u0623\u0648\u0644 \u0646\u0638\u0631\u0629 \u062f\u0648\u0646 \u0623\u064a \u0644\u0628\u0633 \u062d\u0648\u0644 \u0645\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u064a\u0647\nfunction fitOrgTreeToScreen(){\n  const wrap = document.getElementById('orgTreeFit');\n  const inner = document.getElementById('orgTreeInner');\n  if(!wrap || !inner) return;\n  inner.style.transform = 'none';\n  inner.style.width = 'auto';\n  inner.style.height = 'auto';\n  wrap.style.width = 'auto';\n  wrap.style.height = 'auto';\n  const naturalWidth = inner.scrollWidth;\n  const naturalHeight = inner.scrollHeight;\n  const availableWidth = sequenceModalBody.clientWidth - 8;\n  const availableHeight = sequenceModalBody.clientHeight - 60; // \u0645\u0633\u0627\u062d\u0629 \u0623\u0632\u0631\u0627\u0631 \u0627\u0644\u062a\u062d\u0643\u0645\n  let scale = Math.min(1, availableWidth / naturalWidth, availableHeight / naturalHeight);\n  scale = Math.max(scale, 0.28); // \u062d\u062f \u0623\u062f\u0646\u0649 \u0643\u064a \u062a\u0628\u0642\u0649 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0642\u0631\u0627\u0621\u0629\n  wrap.dataset.naturalWidth = naturalWidth;\n  wrap.dataset.naturalHeight = naturalHeight;\n  applyOrgTreeScale(scale, naturalWidth, naturalHeight);\n}\n\nlet orgTreeResizeTimer = null;\nwindow.addEventListener('resize', () => {\n  if(sequenceViewMode !== 'diagram' || !sequenceModal.classList.contains('active')) return;\n  clearTimeout(orgTreeResizeTimer);\n  orgTreeResizeTimer = setTimeout(fitOrgTreeToScreen, 150);\n});\n\nfunction openSequenceModal(){\n  renderSequence();\n  sequenceModal.classList.add('active');\n  sequenceModal.setAttribute('aria-hidden', 'false');\n  document.body.style.overflow = 'hidden';\n}\nfunction closeSequenceModal(){\n  sequenceModal.classList.remove('active');\n  sequenceModal.setAttribute('aria-hidden', 'true');\n  document.body.style.overflow = '';\n}\n\ndocument.getElementById('openSequenceBtn').addEventListener('click', openSequenceModal);\ndocument.getElementById('closeSequenceModal').addEventListener('click', closeSequenceModal);\nsequenceModal.addEventListener('click', (e) => { if(e.target === sequenceModal) closeSequenceModal(); });\ndocument.addEventListener('keydown', (e) => { if(e.key === 'Escape' && sequenceModal.classList.contains('active')) closeSequenceModal(); });\nseqViewDiagramBtn.addEventListener('click', () => { sequenceViewMode = 'diagram'; renderSequence(); });\nseqViewListBtn.addEventListener('click', () => { sequenceViewMode = 'list'; renderSequence(); });\n\nconst placeholderBackBtn = document.getElementById('branchPlaceholderBack');\nif(placeholderBackBtn) placeholderBackBtn.onclick = () => showScreen('branchSelect');\n\ndocument.getElementById('enterBtn').addEventListener('click', () => {\n  const splash = document.getElementById('splash');\n  splash.classList.add('hidden');\n  setTimeout(() => { splash.style.display = 'none'; }, 650);\n  showScreen('branchSelect');\n});\n\nconst headerLeftWrap = document.getElementById('headerLeftWrap');\nconst headerLeftBtn = document.getElementById('headerLeftBtn');\nconst headerDropdown = document.getElementById('headerDropdown');\nheaderLeftBtn.addEventListener('click', () => { headerLeftWrap.classList.toggle('open'); });\ndocument.addEventListener('click', (e) => { if(!headerLeftWrap.contains(e.target)) headerLeftWrap.classList.remove('open'); });\n\nheaderDropdown.querySelectorAll('.header-dropdown-item').forEach(item => {\n  item.addEventListener('click', (e) => {\n    e.stopPropagation();\n    headerLeftWrap.classList.remove('open');\n    if(item.dataset.action === 'home'){\n      screens.app.classList.remove('app-visible'); screens.app.style.display = 'none';\n      const splash = document.getElementById('splash');\n      splash.style.display = 'flex'; setTimeout(() => splash.classList.remove('hidden'), 10);\n    } else if(item.dataset.branch){\n      selectBranch(item.dataset.branch);\n    }\n  });\n});\n\n/* ========================================================================== */\n/* ===================== 6. \u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629 \u0648\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a ===================== */\n/* ========================================================================== */\n\nconst revealObserver = new IntersectionObserver((entries) => {\n  entries.forEach(entry => { entry.target.classList.toggle('in-view', entry.isIntersecting); });\n}, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });\n\nfunction observeReveal(container){ container.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el)); }\n\nconst helpModal = document.getElementById('helpModal');\nconst openHelpBtn = document.getElementById('openHelpBtn');\nconst closeHelpBtn = document.getElementById('closeHelpBtn');\nopenHelpBtn.addEventListener('click', () => { openHelpBtn.classList.add('btn-pop'); setTimeout(() => { openHelpBtn.classList.remove('btn-pop'); }, 300); helpModal.classList.add('active'); });\ncloseHelpBtn.addEventListener('click', () => { helpModal.classList.remove('active'); });\nhelpModal.addEventListener('click', (e) => { if(e.target === helpModal) helpModal.classList.remove('active'); });\n\nconst legendModal = document.getElementById('legendModal');\nconst openLegendBtn = document.getElementById('openLegendBtn');\nconst closeLegendBtn = document.getElementById('closeLegendBtn');\nopenLegendBtn.addEventListener('click', () => { openLegendBtn.classList.add('btn-pop'); setTimeout(() => { openLegendBtn.classList.remove('btn-pop'); }, 300); legendModal.classList.add('active'); });\ncloseLegendBtn.addEventListener('click', () => { legendModal.classList.remove('active'); });\nlegendModal.addEventListener('click', (e) => { if(e.target === legendModal) legendModal.classList.remove('active'); });\n\ndocument.getElementById('developerLink').addEventListener('click', () => {\n  const yanalNode = flatIndex.find(item => item.name === '\u064a\u0646\u0627\u0644' && item.father === '\u0633\u0641\u064a\u0627\u0646');\n  if (yanalNode) { navigateToNodeId(yanalNode.id); window.scrollTo({ top: 0, behavior: 'smooth' }); } \n});\n\nconst settingsIconBtn = document.getElementById('settingsIconBtn');\nconst settingsPanel = document.getElementById('settingsPanel');\nconst settingsOverlay = document.getElementById('settingsOverlay');\nconst settingsPanelClose = document.getElementById('settingsPanelClose');\nfunction openSettingsPanel(){ settingsPanel.classList.add('active'); settingsOverlay.classList.add('active'); }\nfunction closeSettingsPanel(){ settingsPanel.classList.remove('active'); settingsOverlay.classList.remove('active'); }\nsettingsIconBtn.addEventListener('click', (e) => { e.stopPropagation(); settingsPanel.classList.contains('active') ? closeSettingsPanel() : openSettingsPanel(); });\nsettingsPanelClose.addEventListener('click', closeSettingsPanel); settingsOverlay.addEventListener('click', closeSettingsPanel);\n\nconst themeSwitchInput = document.getElementById('themeSwitchInput');\nconst themeRowIcon = document.getElementById('themeRowIcon');\nconst themeRowText = document.getElementById('themeRowText');\nfunction applyTheme(isDark){\n  document.body.classList.toggle('dark-mode', isDark);\n  themeSwitchInput.checked = isDark; themeRowIcon.textContent = isDark ? '\u2600\ufe0f' : '\ud83c\udf19'; themeRowText.textContent = isDark ? '\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0646\u0647\u0627\u0631\u064a' : '\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0644\u064a\u0644\u064a';\n  const _vtModalEl = document.getElementById('visualTreeModal');\n  if (_vtModalEl && _vtModalEl.classList.contains('active') && lastMmArgs) {\n    buildMinimap(lastMmArgs.root, lastMmArgs.x0, lastMmArgs.x1, lastMmArgs.y0, lastMmArgs.y1, lastMmArgs.svg, lastMmArgs.zoom);\n    updateMinimapViewport(d3.zoomTransform(lastMmArgs.svg.node()));\n  }\n}\nconst currentTheme = localStorage.getItem('theme');\napplyTheme(currentTheme === 'dark');\nthemeSwitchInput.addEventListener('change', () => { applyTheme(themeSwitchInput.checked); });\n\n/* ========================================================================== */\n/* ===================== 7. \u0627\u0644\u0634\u062c\u0631\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629 \u0648\u0627\u0644\u0637\u0628\u0627\u0639\u0629 (PDF) ==================== */\n/* ========================================================================== */\n\ndocument.getElementById('printBtn').addEventListener('click', () => {\n  try {\n      const printArea = document.getElementById('printArea');\n      printArea.innerHTML = ''; \n      const focus = currentFocus(); \n\n      const title = document.createElement('h2'); \n      title.className = 'print-title';\n      title.innerHTML = `\u0634\u062c\u0631\u0629 \u0639\u0627\u0626\u0644\u0629 \u0627\u0644\u0642\u0648\u0627\u0633\u0645\u064a<br><span style=\"font-size:16px; color:#7c6c53; font-family:'Cairo', sans-serif;\">\u0648\u062b\u064a\u0642\u0629 \u0625\u062b\u0628\u0627\u062a \u062a\u0633\u0644\u0633\u0644 \u0646\u0633\u0628: ${focus.name}</span>`;\n      printArea.appendChild(title);\n\n      const stem = document.createElement('div'); \n      stem.className = 'lineage-stem';\n\n      const reversedPath = [...currentPath].reverse();\n      reversedPath.forEach((node, index) => {\n        const leaf = document.createElement('div'); leaf.className = 'leaf-item';\n        if(index === 0) leaf.classList.add('focus-leaf');\n        if(index === reversedPath.length - 1) leaf.classList.add('root-leaf');\n        leaf.innerHTML = node.name; stem.appendChild(leaf);\n        if (index < reversedPath.length - 1) {\n          const ben = document.createElement('div'); ben.className = 'ben-label'; ben.innerHTML = '\u0628\u0640\u0646'; stem.appendChild(ben);\n        }\n      });\n      printArea.appendChild(stem);\n\n      const footer = document.createElement('div'); footer.className = 'print-footer';\n      const dateAr = new Date().toLocaleDateString('ar-JO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });\n      footer.innerHTML = `\u0639\u062f\u062f \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u062f\u0627\u062e\u0644 \u0627\u0644\u0634\u062c\u0631\u0629: <span style=\"font-weight:bold; color:#8a5f2e;\">${countAll(activeTree)} \u0641\u0631\u062f</span><br>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631: ${dateAr}`;\n      printArea.appendChild(footer);\n      \n      setTimeout(() => window.print(), 300);\n  } catch (err) {\n      alert(\"\u062d\u062f\u062b \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u0639\u0627\u062f\u064a\u0629: \" + err.message);\n  }\n});\n\nconst vtModal = document.getElementById('visualTreeModal');\nconst vtCanvas = document.getElementById('visualTreeCanvas');\n\n/* Mini-map state: recomputed every time the tree is (re)rendered or resized */\nlet mmState = null;\nlet lastMmArgs = null;\n\nfunction openVisualTree(rootData) {\n  vtModal.classList.add('active');\n  document.getElementById('vtTitle').textContent = `\u0634\u062c\u0631\u0629 \u0646\u0633\u0628: ${rootData.name}`;\n  vtCanvas.innerHTML = ''; \n\n  const root = d3.hierarchy(rootData);\n  \n  // 1. Dynamic Spacing Logic\n  const totalLeaves = root.leaves().length;\n  const maxTreeDepth = root.height;\n  \n  // Scale down dx if there are many leaves to prevent massive horizontal spread\n  // Scale down dy based on depth to keep the view tight\nconst dx = Math.max(400, 500 - (totalLeaves * 6)); \nconst dy = Math.max(750, 1150 - (maxTreeDepth * 55));\n  \n  const tree = d3.tree().nodeSize([dx, dy]);\n  tree(root);\n\n  let x0 = Infinity, x1 = -x0, y0 = Infinity, y1 = -y0;\n  root.each(d => {\n    if (d.x > x1) x1 = d.x; if (d.x < x0) x0 = d.x;\n    if (d.y > y1) y1 = d.y; if (d.y < y0) y0 = d.y;\n  });\n\n  const treeWidth = x1 - x0 + dx * 2;\n  const treeHeight = y1 - y0 + dy * 2;\n\nconst svg = d3.select(\"#visualTreeCanvas\").append(\"svg\")\n      .attr(\"width\", \"100%\")\n      .attr(\"height\", \"100%\")\n      // \u062a\u0645 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u062b\u0627\u0628\u062a \u0644\u064a\u0623\u062e\u0630 \u0644\u0648\u0646 \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u062d\u0633\u0628 \u0627\u0644\u0648\u0636\u0639 (\u0644\u064a\u0644\u064a/\u0646\u0647\u0627\u0631\u064a)\n      .style(\"background\", \"var(--paper)\")\n      .style(\"cursor\", \"grab\")\n      .attr(\"data-x0\", x0)\n      .attr(\"data-x1\", x1)\n      .attr(\"data-y0\", y0)\n      .attr(\"data-y1\", y1);\n\n  const g = svg.append(\"g\");\n\n  const zoom = d3.zoom()\n      .scaleExtent([0.05, 3]) \n      .on(\"zoom\", (event) => {\n          g.attr(\"transform\", event.transform);\n          updateMinimapViewport(event.transform);\n      });\n\n  svg.call(zoom);\n// 1. \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0643\u0648\u062f \u0627\u0644\u0644\u0648\u0646 \u0643\u0642\u064a\u0645\u0629 \u062b\u0627\u0628\u062a\u0629 \u0642\u0628\u0644 \u0627\u0644\u0631\u0633\u0645\n  const currentStyles = getComputedStyle(document.documentElement);\n  const branchColor = currentStyles.getPropertyValue('--theme-no-kids').trim() || \"#7ba869\";\n  const leafFill = currentStyles.getPropertyValue('--theme-has-kids').trim() || \"#3a5c30\";\n  const leafStroke = currentStyles.getPropertyValue('--theme-has-kids-dark').trim() || \"#2d4a25\";\n\n  // 2. \u0631\u0633\u0645 \u0627\u0644\u0623\u063a\u0635\u0627\u0646 \u0628\u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u0631\u062c\n  g.append(\"g\").attr(\"fill\", \"none\").attr(\"stroke\", branchColor).attr(\"stroke-width\", 10).selectAll(\"path\").data(root.links()).join(\"path\").attr(\"d\", d3.linkVertical().x(d => d.x).y(d => d.y));\n\n  const node = g.append(\"g\").selectAll(\"g\").data(root.descendants()).join(\"g\").attr(\"transform\", d => `translate(${d.x},${d.y})`);\n  const leafPath = \"M0,20 C-25,10 -30,-20 0,-40 C30,-20 25,10 0,20 Z\";\n\n  // 3. \u0631\u0633\u0645 \u0627\u0644\u0623\u0648\u0631\u0627\u0642 \u0628\u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u0631\u062c \u0628\u0634\u0643\u0644 \u062b\u0627\u0628\u062a\n  node.append(\"path\").attr(\"d\", leafPath).attr(\"fill\", d => d.depth === 0 ? \"url(#goldGrad)\" : leafFill).attr(\"stroke\", d => d.depth === 0 ? \"#8a5f2e\" : leafStroke).attr(\"stroke-width\", 2).attr(\"transform\", d => d.depth === 0 ? \"scale(13)\" : (d.x < 0 ? \"scale(10) rotate(-25)\" : \"scale(10) rotate(25)\")).style(\"filter\", \"drop-shadow(0px 6px 10px rgba(0,0,0,0.15))\");\n  const defs = svg.append(\"defs\");\n  const grad = defs.append(\"linearGradient\")\n      .attr(\"id\", \"goldGrad\").attr(\"x1\", \"0%\").attr(\"y1\", \"0%\").attr(\"x2\", \"100%\").attr(\"y2\", \"100%\");\n  grad.append(\"stop\").attr(\"offset\", \"0%\").style(\"stop-color\", \"#d3a765\");\n  grad.append(\"stop\").attr(\"offset\", \"100%\").style(\"stop-color\", \"#8a5f2e\");\n\n  // 4. \u0636\u0628\u0637 \u0627\u0644\u0646\u0635\u0648\u0635 \u0648\u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u062f\u0627\u062e\u0644 \u0627\u0644\u0623\u0648\u0631\u0627\u0642\n  node.append(\"text\")\n      .attr(\"dy\", \"0.35em\")\n      .attr(\"fill\", d => d.depth === 0 ? \"#fff\" : \"#f7f1e2\")\n      .attr(\"font-family\", \"'Dubai', 'Segoe UI', Tahoma, sans-serif\") // \u0625\u062c\u0628\u0627\u0631 \u0627\u0644\u0645\u062a\u0635\u0641\u062d \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062e\u0637 \u0627\u0644\u0639\u0631\u0628\u064a\n      .attr(\"font-size\", d => d.depth === 0 ? \"120px\" : \"100px\") // \u0623\u062d\u062c\u0627\u0645 \u062e\u0637\u0648\u0637 \u0645\u062f\u0631\u0648\u0633\u0629 \u0644\u062a\u062a\u0633\u0639 \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u0631\u0642\u0629\n      .attr(\"font-weight\", \"800\")\n      .style(\"text-anchor\", \"middle\")\n      // \u0627\u0644\u0633\u0631 \u0647\u0646\u0627: \u062c\u0639\u0644\u0646\u0627 \u0627\u0644\u0646\u0635 \u0623\u0641\u0642\u064a\u0627\u064b \u062a\u0645\u0627\u0645\u0627\u064b\u060c \u0648\u0642\u0645\u0646\u0627 \u0628\u0625\u0632\u0627\u062d\u062a\u0647 \u0644\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0644\u0644\u0648\u0631\u0642\u0629\n      .attr(\"transform\", d => {\n          if (d.depth === 0) return \"translate(5, -95)\"; // \u0631\u0641\u0639 \u0627\u0644\u0646\u0635 \u0644\u0645\u0646\u062a\u0635\u0641 \u0648\u0631\u0642\u0629 \u0627\u0644\u062c\u062f\n          return d.x < 0 ? \"translate(-18, -70)\" : \"translate(18, -70)\"; // \u062a\u0648\u0633\u064a\u0637 \u0627\u0644\u0646\u0635 \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0627\u0626\u0644\u0629\n      })\n      .text(d => d.data.name);\n\n  // \u0627\u062d\u062a\u0648\u0627\u0621 \u0627\u0644\u0634\u062c\u0631\u0629 \u0641\u064a \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0634\u0627\u0634\u0629 \u0639\u0646\u062f \u0627\u0644\u0641\u062a\u062d\n  const clientWidth = vtCanvas.clientWidth;\n  const clientHeight = vtCanvas.clientHeight;\n  const initialScale = Math.min(clientWidth / treeWidth, clientHeight / treeHeight, 1) * 0.95; \n  \n  const initialX = (clientWidth - (x1 + x0) * initialScale) / 2;\n  const initialY = (clientHeight - (y1 + y0) * initialScale) / 2;\n  \n  svg.call(zoom.transform, d3.zoomIdentity.translate(initialX, initialY).scale(initialScale));\n\n  // 5. \u0628\u0646\u0627\u0621 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629 (Mini-map) \u0648\u0645\u0632\u0627\u0645\u0646\u062a\u0647\u0627 \u0645\u0639 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\n  lastMmArgs = { root, x0, x1, y0, y1, treeWidth, treeHeight, svg, zoom };\n  buildMinimap(root, x0, x1, y0, y1, svg, zoom);\n  updateMinimapViewport(d3.zoomIdentity.translate(initialX, initialY).scale(initialScale));\n}\n/* ============ Mini-map: \u0646\u0638\u0631\u0629 \u0639\u0627\u0645\u0629 \u0645\u0635\u063a\u0651\u0631\u0629 + \u0645\u0624\u0634\u0631 \u062a\u0646\u0642\u0651\u0644 + \u0642\u0641\u0632 \u0645\u0628\u0627\u0634\u0631 ============ */\n\n// \u064a\u0631\u0633\u0645 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 (\u0631\u0648\u0627\u0628\u0637 + \u0639\u0642\u062f) \u0639\u0644\u0649 Canvas \u0644\u0623\u062f\u0627\u0621 \u0633\u0631\u064a\u0639 \u062d\u062a\u0649 \u0645\u0639 \u0622\u0644\u0627\u0641 \u0627\u0644\u0623\u0633\u0645\u0627\u0621\nfunction buildMinimap(root, x0, x1, y0, y1, svg, zoom) {\n  const wrap = document.getElementById('minimapWrap');\n  const canvas = document.getElementById('minimapCanvas');\n  if (!wrap || !canvas) return;\n\n  wrap.style.display = 'block';\n\n  const cw = wrap.clientWidth, ch = wrap.clientHeight;\n  const dpr = window.devicePixelRatio || 1;\n  canvas.width = Math.max(1, cw * dpr);\n  canvas.height = Math.max(1, ch * dpr);\n  canvas.style.width = cw + 'px';\n  canvas.style.height = ch + 'px';\n\n  const ctx = canvas.getContext('2d');\n  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  ctx.clearRect(0, 0, cw, ch);\n\n  const pad = 10;\n  const boundsW = Math.max(1, x1 - x0);\n  const boundsH = Math.max(1, y1 - y0);\n  const scale = Math.min((cw - pad * 2) / boundsW, (ch - pad * 2) / boundsH);\n  const drawnW = boundsW * scale, drawnH = boundsH * scale;\n  const offX = (cw - drawnW) / 2;\n  const offY = (ch - drawnH) / 2;\n\n  const toMmX = (tx) => offX + (tx - x0) * scale;\n  const toMmY = (ty) => offY + (ty - y0) * scale;\n\n// \u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u062a\u064f\u0642\u0631\u0623 \u0645\u0646 \u0645\u062a\u063a\u064a\u0631\u0627\u062a CSS \u0627\u0644\u062d\u064a\u0651\u0629 \u0644\u062a\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u0644\u0648\u0646 \u0627\u0644\u0641\u062e\u0630 \u0627\u0644\u0645\u062e\u062a\u0627\u0631 \u0648\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0644\u064a\u0644\u064a\n  const styles = getComputedStyle(document.documentElement);\n  const linkColor = (styles.getPropertyValue('--theme-no-kids') || '#7ba869').trim();\n  const rootColor = (styles.getPropertyValue('--gold-deep') || '#8a5f2e').trim();\n  const nodeColor = (styles.getPropertyValue('--theme-has-kids') || '#4c7a3f').trim();\n\n  ctx.strokeStyle = linkColor;\n  ctx.lineWidth = 1;\n  ctx.globalAlpha = 0.85;\n  root.links().forEach(link => {\n    ctx.beginPath();\n    ctx.moveTo(toMmX(link.source.x), toMmY(link.source.y));\n    ctx.lineTo(toMmX(link.target.x), toMmY(link.target.y));\n    ctx.stroke();\n  });\n\n  ctx.globalAlpha = 1;\n  root.descendants().forEach(d => {\n    ctx.beginPath();\n    ctx.fillStyle = d.depth === 0 ? rootColor : nodeColor;\n    ctx.arc(toMmX(d.x), toMmY(d.y), d.depth === 0 ? 3.5 : 2, 0, Math.PI * 2);\n    ctx.fill();\n  });\n\n  mmState = { cw, ch, pad, x0, x1, y0, y1, scale, offX, offY, toMmX, toMmY, svg, zoom };\n}\n\nfunction mmTreeXFromPx(px) { return mmState.x0 + (px - mmState.offX) / mmState.scale; }\nfunction mmTreeYFromPx(py) { return mmState.y0 + (py - mmState.offY) / mmState.scale; }\n\n// \u064a\u062d\u062f\u0651\u062b \u0645\u0633\u062a\u0637\u064a\u0644 \"\u0623\u0646\u062a \u0647\u0646\u0627\" \u0641\u064a \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0632\u0648\u0648\u0645 \u0627\u0644\u062d\u0627\u0644\u064a \u0644\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\nfunction updateMinimapViewport(transform) {\n  if (!mmState) return;\n  const viewportEl = document.getElementById('minimapViewport');\n  if (!viewportEl) return;\n\n  const cw = vtCanvas.clientWidth, ch = vtCanvas.clientHeight;\n  const k = transform.k;\n  const treeX0 = -transform.x / k;\n  const treeY0 = -transform.y / k;\n  const treeX1 = (cw - transform.x) / k;\n  const treeY1 = (ch - transform.y) / k;\n\n  let px0 = mmState.toMmX(treeX0);\n  let py0 = mmState.toMmY(treeY0);\n  let px1 = mmState.toMmX(treeX1);\n  let py1 = mmState.toMmY(treeY1);\n\n  // \u0646\u0642\u0635\u0651 \u0627\u0644\u0645\u0633\u062a\u0637\u064a\u0644 \u0639\u0644\u0649 \u062d\u062f\u0648\u062f \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629 \u062d\u062a\u0649 \u0644\u0627 \u064a\u0641\u064a\u0636 \u0628\u0635\u0631\u064a\u0627\u064b\n  px0 = Math.max(0, Math.min(mmState.cw, px0));\n  px1 = Math.max(0, Math.min(mmState.cw, px1));\n  py0 = Math.max(0, Math.min(mmState.ch, py0));\n  py1 = Math.max(0, Math.min(mmState.ch, py1));\n\n  viewportEl.style.left = px0 + 'px';\n  viewportEl.style.top = py0 + 'px';\n  viewportEl.style.width = Math.max(4, px1 - px0) + 'px';\n  viewportEl.style.height = Math.max(4, py1 - py0) + 'px';\n}\n\n// \u064a\u0646\u0642\u0644 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0641\u0648\u0631\u0627\u064b (\u0628\u062f\u0648\u0646 \u0623\u0646\u064a\u0645\u064a\u0634\u0646) \u2014 \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0633\u062d\u0628 \u0644\u0636\u0645\u0627\u0646 \u0627\u0633\u062a\u062c\u0627\u0628\u0629 \u0633\u0644\u0633\u0629\nfunction navigateMinimapInstant(px, py) {\n  if (!mmState) return;\n  const cw = vtCanvas.clientWidth, ch = vtCanvas.clientHeight;\n  const treeX = mmTreeXFromPx(px);\n  const treeY = mmTreeYFromPx(py);\n  const k = d3.zoomTransform(mmState.svg.node()).k;\n  const tx = cw / 2 - treeX * k;\n  const ty = ch / 2 - treeY * k;\n  mmState.svg.call(mmState.zoom.transform, d3.zoomIdentity.translate(tx, ty).scale(k));\n}\n\n// \u064a\u0646\u0642\u0644 \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0628\u0623\u0646\u064a\u0645\u064a\u0634\u0646 \u0633\u0644\u0633 \u2014 \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0639\u0646\u062f \u0627\u0644\u0646\u0642\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629\nfunction navigateMinimapAnimated(px, py) {\n  if (!mmState) return;\n  const cw = vtCanvas.clientWidth, ch = vtCanvas.clientHeight;\n  const treeX = mmTreeXFromPx(px);\n  const treeY = mmTreeYFromPx(py);\n  const k = d3.zoomTransform(mmState.svg.node()).k;\n  const tx = cw / 2 - treeX * k;\n  const ty = ch / 2 - treeY * k;\n  mmState.svg.transition().duration(300).call(\n    mmState.zoom.transform,\n    d3.zoomIdentity.translate(tx, ty).scale(k)\n  );\n}\n\n// \u0625\u062d\u062f\u0627\u062b\u064a\u0627\u062a \u0646\u0642\u0631\u0629/\u0633\u062d\u0628 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0642\u0645\u0627\u0634 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0645\u0635\u063a\u0651\u0631\u0629\nfunction mmPointerPos(clientX, clientY) {\n  const rect = document.getElementById('minimapCanvas').getBoundingClientRect();\n  return { px: clientX - rect.left, py: clientY - rect.top };\n}\n\nconst minimapCanvasEl = document.getElementById('minimapCanvas');\nconst minimapViewportEl = document.getElementById('minimapViewport');\n\n// \u0646\u0642\u0631 \u0645\u0628\u0627\u0634\u0631 \u0641\u064a \u0623\u064a \u0645\u0646\u0637\u0642\u0629 \u0645\u0646 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 => \u0627\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u064a\u0647\u0627 \u0641\u0648\u0631\u0627\u064b \u0641\u064a \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\nminimapCanvasEl.addEventListener('click', (e) => {\n  const { px, py } = mmPointerPos(e.clientX, e.clientY);\n  navigateMinimapAnimated(px, py);\n});\n\n// \u0633\u062d\u0628 \u0645\u0633\u062a\u0637\u064a\u0644 \"\u0623\u0646\u062a \u0647\u0646\u0627\" \u0644\u0644\u062a\u0646\u0642\u0651\u0644 \u0628\u062d\u0631\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0634\u062c\u0631\u0629\nlet mmDragging = false;\nminimapViewportEl.addEventListener('mousedown', (e) => {\n  mmDragging = true;\n  e.preventDefault();\n  e.stopPropagation();\n});\nwindow.addEventListener('mousemove', (e) => {\n  if (!mmDragging) return;\n  const { px, py } = mmPointerPos(e.clientX, e.clientY);\n  navigateMinimapInstant(px, py);\n});\nwindow.addEventListener('mouseup', () => { mmDragging = false; });\n\n// \u062f\u0639\u0645 \u0627\u0644\u0644\u0645\u0633 \u0639\u0644\u0649 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0644\u0648\u062d\u064a\u0629 \u0648\u0627\u0644\u0647\u0648\u0627\u062a\u0641\nminimapViewportEl.addEventListener('touchstart', (e) => {\n  mmDragging = true;\n  e.stopPropagation();\n}, { passive: true });\nwindow.addEventListener('touchmove', (e) => {\n  if (!mmDragging || !e.touches.length) return;\n  const t = e.touches[0];\n  const { px, py } = mmPointerPos(t.clientX, t.clientY);\n  navigateMinimapInstant(px, py);\n}, { passive: true });\nwindow.addEventListener('touchend', () => { mmDragging = false; });\nminimapCanvasEl.addEventListener('touchstart', (e) => {\n  if (!e.touches.length) return;\n  const t = e.touches[0];\n  const { px, py } = mmPointerPos(t.clientX, t.clientY);\n  navigateMinimapAnimated(px, py);\n}, { passive: true });\n\n// \u0625\u0639\u0627\u062f\u0629 \u0631\u0633\u0645 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0639\u0646\u062f \u062a\u063a\u064a\u064a\u0631 \u062d\u062c\u0645 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0623\u062b\u0646\u0627\u0621 \u0641\u062a\u062d \u0627\u0644\u0634\u062c\u0631\u0629 (\u064a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u062f\u0642\u0629 \u0627\u0644\u0645\u0624\u0634\u0631)\nwindow.addEventListener('resize', () => {\n  if (vtModal.classList.contains('active') && lastMmArgs) {\n    buildMinimap(lastMmArgs.root, lastMmArgs.x0, lastMmArgs.x1, lastMmArgs.y0, lastMmArgs.y1, lastMmArgs.svg, lastMmArgs.zoom);\n    updateMinimapViewport(d3.zoomTransform(lastMmArgs.svg.node()));\n  }\n});\n\n// \u0632\u0631 \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0646\u0627\u0641\u0630\u0629\ndocument.getElementById('closeTreeBtn').addEventListener('click', () => {\n  vtModal.classList.remove('active');\n});\n/* ============ \u062e\u0644\u0641\u064a\u0629 \u0632\u062e\u0631\u0641\u064a\u0629 \u0623\u0646\u064a\u0642\u0629 \u0648\u062e\u0641\u064a\u0641\u0629 \u0644\u0648\u062b\u064a\u0642\u0629 \u0627\u0644\u0637\u0628\u0627\u0639\u0629 (\u0628\u062f\u064a\u0644 \u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0631\u0645\u0627\u062f\u064a \u0627\u0644\u0623\u0645\u0644\u0633) ============ */\nfunction drawDecorativePrintBackground(ctx, w, h) {\n  // 1) \u0642\u0627\u0639\u062f\u0629 \u0644\u0648\u0646 \u0627\u0644\u0648\u0631\u0642 \u0627\u0644\u062f\u0627\u0641\u0626 \u2014 \u0646\u0641\u0633 \u0647\u0648\u064a\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\n  ctx.fillStyle = '#fffdf8';\n  ctx.fillRect(0, 0, w, h);\n\n  // 2) \u062a\u0648\u0647\u0651\u062c\u0627\u0646 \u0644\u0648\u0646\u064a\u0627\u0646 \u0646\u0627\u0639\u0645\u0627\u0646 (\u0630\u0647\u0628\u064a \u0648\u0623\u062e\u0636\u0631) \u064a\u0639\u0643\u0633\u0627\u0646 \u0647\u0648\u064a\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062f\u0648\u0646 \u0623\u0646 \u064a\u0634\u062a\u062a\u0627 \u0627\u0644\u0627\u0646\u062a\u0628\u0627\u0647 \u0639\u0646 \u0627\u0644\u0634\u062c\u0631\u0629\n  const bloomTL = ctx.createRadialGradient(w * 0.07, h * 0.05, 0, w * 0.07, h * 0.05, Math.max(w, h) * 0.55);\n  bloomTL.addColorStop(0, 'rgba(201,151,79,0.16)');\n  bloomTL.addColorStop(1, 'rgba(201,151,79,0)');\n  ctx.fillStyle = bloomTL;\n  ctx.fillRect(0, 0, w, h);\n\n  const bloomBR = ctx.createRadialGradient(w * 0.95, h * 0.96, 0, w * 0.95, h * 0.96, Math.max(w, h) * 0.55);\n  bloomBR.addColorStop(0, 'rgba(76,122,63,0.13)');\n  bloomBR.addColorStop(1, 'rgba(76,122,63,0)');\n  ctx.fillStyle = bloomBR;\n  ctx.fillRect(0, 0, w, h);\n\n \n\n  // 4) \u062a\u0638\u0644\u064a\u0644 \u0646\u0627\u0639\u0645 \u0639\u0644\u0649 \u0627\u0644\u0623\u0637\u0631\u0627\u0641 (Vignette) \u064a\u0648\u062c\u0651\u0647 \u0627\u0644\u0639\u064a\u0646 \u0646\u062d\u0648 \u0645\u0631\u0643\u0632 \u0627\u0644\u0634\u062c\u0631\u0629 \u2014 \u062a\u0642\u0646\u064a\u0629 \u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629 \u0641\u064a \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0637\u0628\u0627\u0639\u0629\n  const vignette = ctx.createRadialGradient(w / 2, h / 2, Math.min(w, h) * 0.38, w / 2, h / 2, Math.max(w, h) * 0.74);\n  vignette.addColorStop(0, 'rgba(58,44,30,0)');\n  vignette.addColorStop(1, 'rgba(58,44,30,0.055)');\n  ctx.fillStyle = vignette;\n  ctx.fillRect(0, 0, w, h);\n}\n\n/* ============ \u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u0634\u062c\u0631\u0629 \u0643\u0645\u0644\u0641 PDF (\u0627\u0644\u062d\u0644 \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0644\u0645\u0634\u0643\u0644\u0629 \u0627\u0644\u0642\u0635 \u0648\u0627\u0644\u0640 RTL) ============ */\ndocument.getElementById('exportTreeBtn').addEventListener('click', async () => {\n  const userConsent = confirm(\"\u0647\u0644 \u062a\u0631\u063a\u0628 \u0641\u064a \u062d\u0641\u0638 \u0647\u0630\u0647 \u0627\u0644\u0634\u062c\u0631\u0629 \u0643\u0645\u0644\u0641 PDF \u0639\u0627\u0644\u064a \u0627\u0644\u062f\u0642\u0629\u061f\");\n  if (!userConsent) return;\n\n  await document.fonts.ready;\n\n  const liveSvg = document.querySelector('#visualTreeCanvas svg');\n  if (!liveSvg) {\n    alert(\"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0634\u062c\u0631\u0629.\");\n    return;\n  }\n\n  try {\n    const liveG = liveSvg.querySelector('g');\n\n    // 1. \u0639\u062