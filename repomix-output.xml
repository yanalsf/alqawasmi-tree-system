/* ============ Lineage certificate print styles ============
   Ported from the legacy app's @media print block. Only the element with
   id="lineagePrintArea" is visible when printing — everything else
   (the tree view, modals, etc.) is hidden via the `.no-print` class,
   which LineageCertificateModal applies to a wrapper around the rest
   of the page while it's open. */
.lineage-print-area { display: none; }

@media print {
  @page {
    size: A4 portrait;
    margin: 0 !important;
  }

  body { background: #fff !important; margin: 0; padding: 0; }
  .no-print { display: none !important; }

  .lineage-print-area {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    width: 100% !important;
    height: 100vh !important;
    max-height: 100vh !important;
    overflow: hidden !important;
    box-sizing: border-box;
    padding: 5mm 0 15mm 0 !important;
    background: #fff;
    margin: 0 auto;
    position: relative;
  }

  .lineage-print-title {
    font-family: 'Aref Ruqaa', serif;
    color: #8a5f2e !important;
    text-align: center;
