p-wrap\" id=\"minimapWrap\" title=\"\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0634\u062c\u0631\u0629 \u2014 \u0627\u0636\u063a\u0637 \u0623\u0648 \u0627\u0633\u062d\u0628 \u0644\u0644\u062a\u0646\u0642\u0644\">\n    <span class=\"minimap-label\">\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0634\u062c\u0631\u0629</span>\n    <canvas id=\"minimapCanvas\"></canvas>\n    <div class=\"minimap-viewport\" id=\"minimapViewport\"></div>\n  </div>\n</div>\n\n<div id=\"branchSelect\" class=\"screen\">\n  <div class=\"branch-select-inner\">\n    <h2 class=\"branch-title\">\u0627\u062e\u062a\u0631 \u0627\u0644\u0641\u062e\u0630</h2>\n    <button class=\"btn primary sequence-open-btn\" id=\"openSequenceBtn\" type=\"button\">\n      \ud83c\udf33 <span>\u0639\u0631\u0636 \u0627\u0644\u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u0643\u0627\u0645\u0644 \u0644\u0634\u062c\u0631\u0629 \u0627\u0644\u0639\u0627\u0626\u0644\u0629</span>\n    </button>\n    <div class=\"branch-options\">\n  <div class=\"branch-card\" data-branch=\"dawoud\" data-name=\"\u0641\u062e\u0630 \u062f\u0627\u0648\u0648\u062f\"><div class=\"branch-name\">\u0641\u062e\u0630 \u062f\u0627\u0648\u0648\u062f</div></div>\n  <div class=\"branch-card\" data-branch=\"abu_nawara\" data-name=\"\u0641\u062e\u0630 \u0627\u0628\u0648 \u0646\u0648\u0627\u0631\u0647\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0627\u0628\u0648 \u0646\u0648\u0627\u0631\u0647</div></div>\n  <div class=\"branch-card\" data-branch=\"al_sous\" data-name=\"\u0641\u062e\u0630 \u0627\u0644\u0635\u0648\u0635\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0627\u0644\u0635\u0648\u0635</div></div>\n  <div class=\"branch-card\" data-branch=\"abdullah\" data-name=\"\u0641\u062e\u0630 \u0639\u0628\u062f\u0627\u0644\u0644\u0647\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0639\u0628\u062f\u0627\u0644\u0644\u0647</div></div>\n  <div class=\"branch-card\" data-branch=\"al_jadaa\" data-name=\"\u0641\u062e\u0630 \u0627\u0644\u062c\u062f\u0639\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0627\u0644\u062c\u062f\u0639</div></div>\n  <div class=\"branch-card\" data-branch=\"mohammed_sulaiman\" data-name=\"\u0641\u062e\u0630 \u0645\u062d\u0645\u062f \u0633\u0644\u064a\u0645\u0627\u0646\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0645\u062d\u0645\u062f \u0633\u0644\u064a\u0645\u0627\u0646</div></div>\n  <div class=\"branch-card\" data-branch=\"younes\" data-name=\"\u0641\u062e\u0630 \u064a\u0648\u0646\u0633\"><div class=\"branch-name\">\u0641\u062e\u0630 \u064a\u0648\u0646\u0633</div></div>\n  <div class=\"branch-card\" data-branch=\"al_badawi\" data-name=\"\u0641\u062e\u0630 \u0627\u0644\u0628\u062f\u0648\u064a\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0627\u0644\u0628\u062f\u0648\u064a</div></div>\n  <div class=\"branch-card\" data-branch=\"mohammed_ali\" data-name=\"\u0641\u062e\u0630 \u0645\u062d\u0645\u062f \u0639\u0644\u064a\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0645\u062d\u0645\u062f \u0639\u0644\u064a</div></div>\n  <div class=\"branch-card\" data-branch=\"abu_baid\" data-name=\"\u0641\u062e\u0630 \u0627\u0628\u0648 \u0628\u064a\u0636\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0627\u0628\u0648 \u0628\u064a\u0636</div></div>\n  <div class=\"branch-card\" data-branch=\"al_khudair\" data-name=\"\u0641\u062e\u0630 \u0627\u0644\u062e\u0636\u064a\u0631\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0627\u0644\u062e\u0636\u064a\u0631</div></div>\n  <div class=\"branch-card\" data-branch=\"abdulhaq\" data-name=\"\u0641\u062e\u0630 \u0639\u0628\u062f \u0627\u0644\u062d\u0642\"><div class=\"branch-name\">\u0641\u062e\u0630 \u0639\u0628\u062f \u0627\u0644\u062d\u0642</div></div>\n</div>\n    <p class=\"branch-note\">\u064a\u0631\u062c\u0649 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0641\u062e\u0630 \u0627\u0644\u0635\u062d\u064a\u062d</p>\n  </div>\n</div>\n\n<div id=\"branchPlaceholder\" class=\"screen\">\n  <div class=\"branch-select-inner\">\n    <h2 class=\"branch-title\" id=\"branchPlaceholderTitle\"></h2>\n    <p class=\"branch-note\">\u0628\u064a\u0627\u0646\u0627\u062a \u0647\u0630\u0627 \u0627\u0644\u0641\u062e\u0630 \u0642\u064a\u062f \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u062d\u0627\u0644\u064a\u064b\u0627.</p>\n    <button class=\"btn primary\" id=\"branchPlaceholderBack\" style=\"margin-top:14px;\">\u27f5 \u0627\u0644\u0639\u0648\u062f\u0629 \u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0641\u062e\u0630</button>\n  </div>\n</div>\n\n<!-- ============ \u0646\u0627\u0641\u0630\u0629 \u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u0623\u0641\u062e\u0627\u0630 \u0627\u0644\u0643\u0627\u0645\u0644 (Sequence / Lineage Modal) ============ -->\n<div class=\"sequence-modal-overlay\" id=\"sequenceModal\" aria-hidden=\"true\">\n  <div class=\"sequence-modal-panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sequenceModalTitle\">\n    <div class=\"sequence-modal-header\">\n      <h3 id=\"sequenceModalTitle\">\ud83c\udf33 \u062a\u0633\u0644\u0633\u0644 \u0627\u0644\u0623\u0641\u062e\u0627\u0630 \u0627\u0644\u0643\u0627\u0645\u0644</h3>\n      <div class=\"sequence-view-toggle\" role=\"tablist\" aria-label=\"\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0639\u0631\u0636\">\n        <button type=\"button\" class=\"seq-toggle-btn\" id=\"seqViewDiagram\" role=\"tab\">\u0645\u062e\u0637\u0637</button>\n        <button type=\"button\" class=\"seq-toggle-btn\" id=\"seqViewList\" role=\"tab\">\u0642\u0627\u0626\u0645\u0629</button>\n      </div>\n      <button type=\"button\" class=\"sequence-modal-close\" id=\"closeSequenceModal\" aria-label=\"\u0625\u063a\u0644\u0627\u0642\">\u2715</button>\n    </div>\n    <p class=\"sequence-modal-hint\">\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0633\u0645 \u0623\u064a \u0641\u062e\u0630 (\u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0644\u0648\u0651\u0646\u0629) \u0644\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0645\u0628\u0627\u0634\u0631\u0629 \u0625