oin=\"round\"/>\n  </svg>\n  <span class=\"label\">\u0631\u062c\u0648\u0639</span>\n</button>\n      <button class=\"btn ghost\" id=\"homeBtn\">\ud83c\udfe0 <span class=\"label\">\u0627\u0644\u0628\u062f\u0627\u064a\u0629</span></button>\n      <button class=\"btn ghost\" id=\"openLegendBtn\">\ud83c\udfa8 <span class=\"label\">\u062f\u0644\u064a\u0644 \u0627\u0644\u0623\u0644\u0648\u0627\u0646</span></button>\n      <button class=\"btn ghost\" id=\"openHelpBtn\">\ud83d\udca1 <span class=\"label\">\u062f\u0644\u064a\u0644 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629</span></button>\n\n      <button class=\"btn ghost\" id=\"printBtn\">\ud83d\udda8\ufe0f <span class=\"label\">\u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u0646\u0633\u0628 (PDF)</span></button>\n\n      <!-- <button class=\"btn primary\" id=\"exportBtn\"><span class=\"label\">\u062a\u0635\u062f\u064a\u0631 JSON</span></button> -->\n    </div>\n\n    <nav class=\"breadcrumb\" id=\"breadcrumb\"></nav>\n    \n    <div class=\"page-wrap\">\n      <div class=\"page\" id=\"pageContent\"></div>\n      <div class=\"stats-line\" id=\"statsBar\"></div>\n      <div class=\"page-wrap\">\n      <div class=\"page\" id=\"pageContent\"></div>\n      <div class=\"stats-line\" id=\"statsBar\"></div>\n\n\n\n\n      <!-- \u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0641\u0648\u0631\u0645 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629 (\u0645\u062e\u0641\u064a\u0629 \u0648\u062a\u0638\u0647\u0631 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637) -->\n      <div class=\"legend-modal-overlay\" id=\"addPersonModal\">\n        <div class=\"legend-modal-content\" style=\"max-width: 600px; max-height: 85vh; overflow-y: auto; text-align: right; direction: rtl;\">\n          \n          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid rgba(138,95,46,0.2); padding-bottom: 10px;\">\n              <h3 style=\"margin: 0; color: var(--gold-deep); font-fam