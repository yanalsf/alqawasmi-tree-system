import mysql from "mysql2/promise";

// Reuses one pool across hot-reloads in dev instead of opening a new one per request.
declare global {
  // eslint-disable-next-line no-var
  var _mysqlPool: mysql.Pool | undefined;
}

export const pool =
  global._mysqlPool ??
  mysql.createPool({
    host: process.env.DB_HOST,
    port: Number(process.env.DB_PORT ?? 3306),
    user: process.env.DB_USER,
    password: process.env.DB_PASSWORD,
    database: process.env.DB_NAME,
    waitForConnections: true,
    connectionLimit: 10,
  });

if (process.env.NODE_ENV !== "production") {
  global._mysqlPool = pool;
}

// Re-exported so existing `import { VIRTUAL_ROOT_ID, FamilyNode } from "@/lib/db"`
// call sites in server code (API routes) keep working unchanged.
export { VIRTUAL_ROOT_ID } from "./constants";
export type { FamilyNode } from "./constants";
import { VIRTUAL_ROOT_ID, FamilyNode } from "./constants";

// Matches the live table: person(person_id, name_text, parent_id, birth_date,
// death_date, created_at, updated_at, branch_id).
export interface PersonRow {
  person_id: number;
  name_text: string;
  parent_id: number | null;
  birth_date: string | null;
  death_date: string | null;
  branch_id: string | null;
}

/** Turns the flat `person` table into the nested shape the front end expects. */
export function buildTree(rows: PersonRow[], parentId: number = VIRTUAL_ROOT_ID): FamilyNode[] {
  return rows
    .filter((r) => r.parent_id === parentId)
    .map((r) => {
      const children = buildTree(rows, r.person_id);
      const node: FamilyNode = {
        id: r.person_id,
        name: r.name_text,
        birth_date: r.birth_date,
        death_date: r.death_date,
      };
      if (children.length) node.children = children;
      return node;
    });
}

export async function fetchFullTree(): Promise<FamilyNode> {
  const [rows] = await pool.query<mysql.RowDataPacket[]>("SELECT * FROM person");
  return {
    id: VIRTUAL_ROOT_ID,
    name: "System_Root",
    birth_date: null,
    death_date: null,
    children: buildTree(rows as PersonRow[], VIRTUAL_ROOT_ID),
  };
}

/** Looks up the branch_id of an existing person, so new children can inherit it. */
export async function getBranchId(personId: number): Promise<string | null> {
  const [rows] = await pool.query<mysql.RowDataPacket[]>(
    "SELECT branch_id FROM person WHERE person_id = ? LIMIT 1",
    [personId]
  );
  const row = (rows as any[])[0];
  return row ? row.branch_id : null;
}
</file>

<file path="apps/admin/lib/sync.ts">
import { writeFile } from "fs/promises";
import path from "path";
import { simpleGit } from "simple-git";
import { fetchFullTree } from "./db";

/**
 * Regenerates apps/public/data/tree.json from the database and pushes it to
 * the git repo that Netlify is watching, so the public site picks up the
 * change on its next auto-deploy.
 *
 * SITE_REPO_PATH (in .env.local) should point at the root of THIS monorepo's
 * git checkout — the same one containing apps/public — since that's what's
 * connected to Netlify.
 */
export async function syncToPublicSite(): Promise<void> {
  const tree = await fetchFullTree();

  const repoPath = process.env.SITE_REPO_PATH;
  if (!repoPath) {
    console.warn("[sync] SITE_REPO_PATH is not set — skipping git sync (wrote tree.json locally only).");
    return;
  }

  const targetFile = path.join(repoPath, "apps", "public", "data", "tree.json");
  await writeFile(targetFile, JSON.stringify(tree, null, 2), "utf-8");

  try {
    const git = simpleGit(repoPath);
    await git.add("apps/public/data/tree.json");
    const status = await git.status();
    if (status.staged.length === 0) {
      return; // nothing changed (e.g. identical data) — nothing to commit
    }
    await git.commit(`sync: update family tree data (${new Date().toISOString()})`);
    await git.push("origin", "main");
    console.log("[sync] Pushed updated tree.json — Netlify will redeploy shortly.");
  } catch (err) {
    // Don't fail the whole API request just because the push failed (e.g. no
    // network, or a merge conflict) — the DB write already succeeded, and the
    // local tree.json is already updated for the next successful sync.
    console.error("[sync] git commit/push failed:", err);
  }
}
</file>

<file path="apps/admin/lib/treeUtils.ts">
// apps/admin/lib/treeUtils.ts
//
// Pure, client-safe helpers for updating a FamilyNode tree immutably.
// Each function only clones the nodes on the path down to the target —
// everything else keeps its original object reference, so React doesn't
// re-render branches that didn't change.

import { VIRTUAL_ROOT_ID, type FamilyNode } from "./constants";

/** Appends `newChild` to the children of the node whose id === parentId. */
export function addChildToTree(node: FamilyNode, parentId: number, newChild: FamilyNode): FamilyNode {
  if (node.id === parentId) {
    return { ...node, children: [...(node.children ?? []), newChild] };
  }
  return mapChildren(node, (child) => addChildToTree(child, parentId, newChild));
}

/** Returns a new tree with the node matching `id` updated via `updates` (name/dates). */
export function updateNodeInTree(
  node: FamilyNode,
  id: number,
  updates: Partial<Pick<FamilyNode, "name" | "birth_date" | "death_date">>
): FamilyNode {
  if (node.id === id) {
    return { ...node, ...updates };
  }
  return mapChildren(node, (child) => updateNodeInTree(child, id, updates));
}

/** Returns a new tree with the node matching `id` (and its whole subtree) removed. */
export function removeNodeFromTree(node: FamilyNode, id: number): FamilyNode {
  if (!node.children?.length) return node;

  const filteredChildren = node.children.filter((child) => child.id !== id);
  const childrenChangedByRemoval = filteredChildren.length !== node.children.length;

  const nextChildren = filteredChildren.map((child) => removeNodeFromTree(child, id));
  const childrenChangedByRecursion = nextChildren.some((child, i) => child !== filteredChildren[i]);

  if (!childrenChangedByRemoval && !childrenChangedByRecursion) return node;

  return { ...node, children: nextChildren.length ? nextChildren : undefined };
}

/** Finds a node by id anywhere in the tree, or null if not present. */
export function findNodeById(node: FamilyNode, id: number): FamilyNode | null {
  if (node.id === id) return node;
  for (const child of node.children ?? []) {
    const found = findNodeById(child, id);
    if (found) return found;
  }
  return null;
}

/**
 * Returns the chain of nodes from `root` down to the node matching `id`
 * (inclusive of both ends), or null if `id` isn't found. Used by the lineage
 * certificate — since every node has exactly one parent, this chain is the
 * unique ancestor path, same as the legacy app's `currentPath`.
 */
export function getPathToRoot(root: FamilyNode, id: number): FamilyNode[] | null {
  if (root.id === id) return [root];
  for (const child of root.children ?? []) {
    const path = getPathToRoot(child, id);
    if (path) return [root, ...path];
  }
  return null;
}

/** Counts every real person in the tree (excludes the synthetic 941 virtual root itself). */
export function countAllPeople(node: FamilyNode): number {
  const ownCount = node.id === VIRTUAL_ROOT_ID ? 0 : 1;
  const childCount = (node.children ?? []).reduce((sum, child) => sum + countAllPeople(child), 0);
  return ownCount + childCount;
}

/** Internal: maps over a node's children with `fn`, only cloning if something actually changed. */
function mapChildren(node: FamilyNode, fn: (child: FamilyNode) => FamilyNode): FamilyNode {
  if (!node.children?.length) return node;

  let changed = false;
  const nextChildren = node.children.map((child) => {
    const updated = fn(child);
    if (updated !== child) changed = true;
    return updated;
  });

  return changed ? { ...node, children: nextChildren } : node;
}
